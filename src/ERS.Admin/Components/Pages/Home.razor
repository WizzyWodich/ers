@page "/"

<PageTitle>ERS Admin — Группы</PageTitle>

<div class="p-8">
    @* Заголовок *@
    <div class="mb-6 flex items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Группы</h1>
            <p class="text-sm text-zinc-500 mt-1">Все активные группы колледжа</p>
        </div>

        <div class="flex items-center gap-2">
            <button class="px-3 py-2 rounded-lg text-sm font-medium
                           bg-zinc-900 border border-zinc-800 text-zinc-300
                           hover:bg-zinc-800 transition-colors">
                Фильтр
            </button>
            <button class="px-3 py-2 rounded-lg text-sm font-medium
                           bg-blue-500 text-white
                           hover:bg-blue-600 transition-colors
                           shadow-lg shadow-blue-500/20">
                + Добавить
            </button>
        </div>
    </div>

    @* Сетка групп *@
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        @foreach (var g in Groups)
        {
            <a href="/group/@g.Id"
               class="text-left p-4 rounded-xl bg-zinc-900/60 border border-zinc-800
                      hover:border-zinc-700 hover:bg-zinc-900
                      hover:-translate-y-0.5 transition-all duration-200 group block">
                <div class="flex items-start justify-between mb-3">
                    <div class="w-9 h-9 rounded-lg bg-zinc-800 flex items-center justify-center
                                text-xs font-bold text-zinc-400
                                group-hover:bg-blue-500/20 group-hover:text-blue-400 transition-colors">
                        @g.DisplayName
                    </div>
                    <span class="text-[10px] font-mono text-zinc-600 tabular-nums">
                        @g.Course курс
                    </span>
                </div>

                <p class="text-sm font-medium text-zinc-100">@g.DisplayName</p>
                <p class="text-[11px] text-zinc-500 mt-0.5">@g.Specialty</p>
            </a>
        }
    </div>
</div>

@code {
    private sealed record GroupMock(string Id, string DisplayName, int Course, string Specialty);

    private List<GroupMock> Groups { get; } = new()
    {
        new("k21", "К-21", 2, "Компьютерные системы"),
        new("k22", "К-22", 2, "Компьютерные системы"),
        new("b31", "Б-31", 3, "Бухгалтерский учёт"),
        new("b32", "Б-32", 3, "Бухгалтерский учёт"),
        new("p41", "П-41", 4, "Программирование"),
        new("ag11", "Аг-11", 1, "Агрономия"),
        new("ag21", "Аг-21", 2, "Агрономия"),
        new("d11", "Д-11", 1, "Дизайн"),
        new("d21", "Д-21", 2, "Дизайн"),
        new("e31", "Е-31", 3, "Экономика"),
        new("e32", "Е-32", 3, "Экономика"),
        new("k41", "К-41", 4, "Компьютерные системы"),
    };
}