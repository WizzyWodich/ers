@page "/group/{Id}"
@using ERS.Admin.Components.Group
@inject Localizer L

<PageTitle>@L["nav.schedule"] — @currentGroup.DisplayName</PageTitle>

<div class="p-6 lg:p-8">

    <div class="flex items-center gap-2 text-sm text-slate-500 dark:text-zinc-500 mb-4">
        <a href="/" class="hover:text-slate-900 dark:hover:text-zinc-100 transition-colors">@L["nav.schedule"]</a>
        <span>/</span>
        <span class="text-slate-900 dark:text-zinc-100 font-medium">@currentGroup.DisplayName</span>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-[1fr_320px] 2xl:grid-cols-[1fr_360px] gap-6">

        <div class="min-w-0">

            <div class="flex items-center gap-3 flex-wrap mb-5">
                <GroupSwitcher Current="currentGroup" Groups="Groups" />

                <DateNavigator DayOfWeek="@DayOfWeekLabel"
                               DateLabel="@DateLabel"
                               OnPrev="PrevDay"
                               OnToday="GoToday"
                               OnNext="NextDay" />

                <div class="ml-auto flex items-center gap-2">
                    <button @onclick="() => showOverrideModal = true"
                            title="@L["group.createOverride"]"
                            class="flex items-center gap-2 px-3 xl:px-3.5 h-9 rounded-lg
                                   bg-blue-500 hover:bg-blue-600
                                   text-white text-sm font-medium
                                   shadow-lg shadow-blue-500/20
                                   transition-colors">
                        <PlusIcon class="w-4 h-4 shrink-0" />
                        <span class="hidden xl:inline">@L["group.createOverride"]</span>
                    </button>

                    @if (DraftCountForGroup > 0)
                    {
                        <button @onclick="PublishGroupDrafts"
                                title="@L.Format("publish.title", DraftCountForGroup)"
                                class="flex items-center gap-2 px-3 xl:px-3.5 h-9 rounded-lg
                                       bg-amber-500 hover:bg-amber-600
                                       text-white text-sm font-medium
                                       shadow-lg shadow-amber-500/20
                                       transition-colors">
                            <CloudArrowUpIcon class="w-4 h-4 shrink-0" />
                            <span class="hidden xl:inline">@L.Format("publish.button", DraftCountForGroup)</span>
                            <span class="xl:hidden tabular-nums">(@DraftCountForGroup)</span>
                        </button>
                    }
                </div>
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-[360px_1fr] gap-4 mb-5 items-start">
                <CalendarBlock ShowMonth="showMonth"
                               OnToggle="ToggleCalendar"
                               OnDayClick="SelectDate"
                               SelectedDate="currentDate" />

                <BellScheduleCard />
            </div>

            <ScheduleTable>
                <ScheduleRow Start="08:00" End="09:20"
                             Subject="Програмування"
                             Teacher="Петров І.С."
                             Room="301"
                             Status="Normal" />

                <BreakRow Time="09:20–09:30" Duration="10" Type="Small" />

                <ScheduleRow Start="09:30" End="10:50"
                             Subject="Математика"
                             Teacher="Сидоров О.В."
                             OldTeacher="Петров І.С."
                             Room="302"
                             Status="Substituted"
                             IsDraft="true" />

                <BreakRow Time="10:50–11:40" Duration="50" Type="Big" />

                <ScheduleRow Start="11:40" End="13:00"
                             Subject="Фізкультура"
                             Teacher="Іванов П.П."
                             Room="Спортзал"
                             Status="Normal"
                             IsDraft="true" />

                <ScheduleRow Start="13:10" End="14:30"
                             Subject="Історія"
                             Teacher="Кузнєцова М.І."
                             Room="305"
                             Status="Cancelled"
                             IsDraft="true" />
            </ScheduleTable>
        </div>

        <aside class="hidden xl:block space-y-4">

            <div class="rounded-xl border border-slate-200 dark:border-zinc-800
                        bg-white dark:bg-zinc-900/40 p-4">
                <h3 class="text-[10px] font-semibold text-slate-500 dark:text-zinc-500 uppercase tracking-wider mb-3">
                    @L["group.about"]
                </h3>
                <div class="space-y-2.5">
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-xs text-slate-500 dark:text-zinc-400">@L["group.specialty"]</span>
                        <span class="text-xs font-medium text-right truncate">@currentGroup.Specialty</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-slate-500 dark:text-zinc-400">@L["group.course"]</span>
                        <span class="text-xs font-medium">2</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-slate-500 dark:text-zinc-400">@L["group.students"]</span>
                        <span class="text-xs font-medium tabular-nums">24</span>
                    </div>
                </div>
            </div>

            <div class="rounded-xl border border-slate-200 dark:border-zinc-800
                        bg-white dark:bg-zinc-900/40 p-4">
                <h3 class="text-[10px] font-semibold text-slate-500 dark:text-zinc-500 uppercase tracking-wider mb-3">
                    @L["group.today"]
                </h3>
                <div class="space-y-2.5">
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-slate-500 dark:text-zinc-400">@L["group.pairs"]</span>
                        <span class="text-sm font-semibold tabular-nums">4</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-slate-500 dark:text-zinc-400">@L["group.start"]</span>
                        <span class="text-sm font-semibold font-mono tabular-nums">08:00</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-slate-500 dark:text-zinc-400">@L["group.end"]</span>
                        <span class="text-sm font-semibold font-mono tabular-nums">14:30</span>
                    </div>

                    <div class="border-t border-slate-100 dark:border-zinc-800 pt-2.5 mt-1"></div>

                    <div class="flex items-center justify-between">
                        <span class="text-xs text-slate-500 dark:text-zinc-400">@L["group.substitutions"]</span>
                        <span class="text-sm font-semibold tabular-nums text-amber-600 dark:text-amber-400">1</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-slate-500 dark:text-zinc-400">@L["group.cancelled"]</span>
                        <span class="text-sm font-semibold tabular-nums text-red-600 dark:text-red-400">1</span>
                    </div>
                </div>
            </div>

            <div class="rounded-xl border border-slate-200 dark:border-zinc-800
                        bg-white dark:bg-zinc-900/40 p-4">
                <h3 class="text-[10px] font-semibold text-slate-500 dark:text-zinc-500 uppercase tracking-wider mb-3">
                    @L["group.curator"]
                </h3>
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full bg-gradient-to-br from-violet-500 to-purple-600
                                flex items-center justify-center text-xs font-semibold text-white shrink-0">
                        КМ
                    </div>
                    <div class="min-w-0">
                        <p class="text-sm font-medium truncate">Кузнєцова М.І.</p>
                        <p class="text-[11px] text-slate-500 dark:text-zinc-500 truncate">kuznetsova@college.ua</p>
                    </div>
                </div>
            </div>

            <div class="rounded-xl border border-slate-200 dark:border-zinc-800
                        bg-white dark:bg-zinc-900/40 p-2">
                <button @onclick="() => showOverrideModal = true"
                        class="w-full flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-left
                               hover:bg-slate-50 dark:hover:bg-zinc-800/60 transition-colors">
                    <PlusIcon class="w-4 h-4 text-slate-400 dark:text-zinc-500 shrink-0" />
                    @L["group.createOverride"]
                </button>
                <div title="@L["common.inDevelopment"]"
                     class="w-full flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-left
                            text-slate-400 dark:text-zinc-600
                            cursor-not-allowed select-none">
                    <PrinterIcon class="w-4 h-4 shrink-0" />
                    <span class="flex-1 truncate">@L["group.print"]</span>
                    <LockClosedIcon class="w-3.5 h-3.5 shrink-0" />
                </div>
            </div>
        </aside>
    </div>
</div>

<OverrideModal IsOpen="showOverrideModal"
               OnClose="() => showOverrideModal = false"
               PreGroupId="@Id" />

@code {
    [Parameter] public string Id { get; set; } = "";

    private bool showMonth;
    private bool showOverrideModal;

    private GroupSwitcher.GroupItem currentGroup = default!;

    private DateOnly currentDate = DateOnly.FromDateTime(DateTime.Today);

    private List<GroupSwitcher.GroupItem> Groups { get; } = new()
    {
        new("k21", "К-21", "Комп'ютерні системи"),
        new("k22", "К-22", "Комп'ютерні системи"),
        new("k41", "К-41", "Комп'ютерні системи"),
        new("b31", "Б-31", "Бухгалтерський облік"),
        new("b32", "Б-32", "Бухгалтерський облік"),
        new("p41", "П-41", "Програмування"),
        new("ag11", "Аг-11", "Агрономія"),
        new("ag21", "Аг-21", "Агрономія"),
        new("d11", "Д-11", "Дизайн"),
        new("d21", "Д-21", "Дизайн"),
        new("e31", "Е-31", "Економіка"),
        new("e32", "Е-32", "Економіка"),
    };

    private string DayOfWeekLabel => L.DayOfWeekFull(currentDate.DayOfWeek);
    private string DateLabel => $"{currentDate.Day} {L.MonthName(currentDate.Month)} {currentDate.Year}";

    protected override void OnParametersSet()
    {
        currentGroup = Groups.FirstOrDefault(g => g.Id == Id) ?? Groups[0];
    }

    private void ToggleCalendar(bool month) => showMonth = month;

    private int DraftCountForGroup => 3;

    private void PublishGroupDrafts() { }
    private void SelectDate(DateOnly date) { currentDate = date; }
    private void PrevDay() { currentDate = currentDate.AddDays(-1); }
    private void GoToday() { currentDate = DateOnly.FromDateTime(DateTime.Today); }
    private void NextDay() { currentDate = currentDate.AddDays(1); }
}
