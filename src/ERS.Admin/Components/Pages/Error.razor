@page "/Error"
@layout EmptyLayout
@using System.Diagnostics
@inject Localizer L
@inject NavigationManager Nav

<PageTitle>@L["error.title"]</PageTitle>

<div class="min-h-screen flex items-center justify-center px-6
            bg-slate-50 dark:bg-zinc-950 text-slate-900 dark:text-zinc-100">

    <div class="w-full max-w-md text-center">

        <div class="w-16 h-16 mx-auto rounded-2xl bg-red-500/10
                    flex items-center justify-center mb-6">
            <ExclamationTriangleIcon class="w-8 h-8 text-red-500 dark:text-red-400" />
        </div>

        <h1 class="text-2xl font-semibold tracking-tight mb-2">
            @L["error.title"]
        </h1>

        <p class="text-sm text-slate-500 dark:text-zinc-500 leading-relaxed mb-8">
            @L["error.description"]
        </p>

        <div class="flex items-center justify-center gap-2 mb-8">
            <a href="/"
               class="flex items-center gap-2 px-4 h-10 rounded-lg
                      bg-blue-500 hover:bg-blue-600
                      text-white text-sm font-medium
                      shadow-lg shadow-blue-500/20
                      transition-colors">
                <HomeIcon class="w-4 h-4" />
                @L["error.goHome"]
            </a>

            <button @onclick="() => Nav.Refresh()"
                    class="flex items-center gap-2 px-4 h-10 rounded-lg
                           text-sm font-medium
                           bg-white dark:bg-zinc-900
                           border border-slate-200 dark:border-zinc-800
                           text-slate-700 dark:text-zinc-300
                           hover:bg-slate-50 dark:hover:bg-zinc-800
                           transition-colors">
                <ArrowPathIcon class="w-4 h-4" />
                @L["error.reload"]
            </button>
        </div>

        @if (ShowRequestId)
        {
            <div class="pt-6 border-t border-slate-200 dark:border-zinc-800">
                <p class="text-[10px] font-medium text-slate-400 dark:text-zinc-600
                          uppercase tracking-wider mb-1">
                    @L["error.requestId"]
                </p>
                <code class="text-xs font-mono text-slate-500 dark:text-zinc-500 break-all">
                    @RequestId
                </code>
            </div>
        }
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
