@page "/not-found"
@layout MainLayout
@inject Localizer L

<PageTitle>@L["notFound.title"]</PageTitle>

<div class="h-[calc(100vh-3.5rem)] flex items-center justify-center px-6">

    <div class="w-full max-w-md text-center">

        <div class="w-16 h-16 mx-auto rounded-2xl bg-slate-200 dark:bg-zinc-900
                    flex items-center justify-center mb-6">
            <MagnifyingGlassIcon class="w-8 h-8 text-slate-400 dark:text-zinc-500" />
        </div>

        <p class="text-5xl font-bold tracking-tight text-slate-300 dark:text-zinc-800 mb-3">
            404
        </p>

        <h1 class="text-2xl font-semibold tracking-tight mb-2">
            @L["notFound.title"]
        </h1>

        <p class="text-sm text-slate-500 dark:text-zinc-500 leading-relaxed mb-8">
            @L["notFound.description"]
        </p>

        <a href="/"
           class="inline-flex items-center gap-2 px-4 h-10 rounded-lg
                  bg-blue-500 hover:bg-blue-600
                  text-white text-sm font-medium
                  shadow-lg shadow-blue-500/20
                  transition-colors">
            <HomeIcon class="w-4 h-4" />
            @L["notFound.goHome"]
        </a>
    </div>
</div>
