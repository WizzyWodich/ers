@page "/week-desk"
@using ERS.Admin.Components.WeekDesk
@using ERS.Admin.Components.Override
@inject Localizer L

<PageTitle>@L["weekDesk.title"]</PageTitle>

<div class="p-6 lg:p-8">

    <div class="mb-6 flex items-end justify-between gap-4 flex-wrap">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">@L["weekDesk.title"]</h1>
            <p class="text-sm text-slate-500 dark:text-zinc-500 mt-1">
                @PackageTitle
                · <span class="tabular-nums">@TotalCount</span> @L["weekDesk.overrides"]
                · <span class="tabular-nums">@GroupCount</span> @L["weekDesk.groups"]
            </p>
        </div>

        <div class="flex items-center gap-2">
            <button class="px-3.5 h-9 rounded-lg text-sm font-medium
                           bg-white dark:bg-zinc-900
                           border border-slate-200 dark:border-zinc-800
                           text-slate-700 dark:text-zinc-300
                           hover:bg-slate-50 dark:hover:bg-zinc-800 transition-colors">
                @L["weekDesk.createBatch"]
            </button>
            <button @onclick="PublishAll"
                    disabled="@(TotalCount == 0)"
                    class="flex items-center gap-2 px-3.5 h-9 rounded-lg
                           text-sm font-medium transition-colors
                           @(TotalCount > 0
                               ? "bg-amber-500 hover:bg-amber-600 text-white shadow-lg shadow-amber-500/20"
                               : "bg-slate-100 dark:bg-zinc-800 text-slate-400 dark:text-zinc-600 cursor-not-allowed")">
                <CloudArrowUpIcon class="w-4 h-4" />
                @L["weekDesk.publishAll"] (@TotalCount)
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-3">
        @foreach (var col in Columns)
        {
            <DayColumn Day="col.Day"
                       DayOfWeek="col.DayOfWeek"
                       Items="col.Items"
                       OnAdd="() => AddOverride(col.Day)"
                       OnRemove="(id) => RemoveOverride(id)"
                       OnDuplicate="(item) => DuplicateOverride(item, col.Day)"
                       OnCopyDay="() => CopyDay(col.Day)" />
        }
    </div>

    @if (TotalCount > 0)
    {
        <div class="mt-5 flex items-center gap-3 px-4 py-3 rounded-xl
                    bg-amber-500/5 border border-amber-500/20
                    text-sm text-amber-700 dark:text-amber-400">
            <InformationCircleIcon class="w-5 h-5 shrink-0" />
            <span>@L.Format("weekDesk.draftInfo", TotalCount)</span>
        </div>
    }
</div>

<OverrideModal IsOpen="showModal" OnClose="CloseModal" PreDate="modalDate" />

@code {
    public sealed record OverrideItem(string Id, string Group, string Pairs, string Action, string Target, string? Reason);

    public sealed record DayColumnItem(DateOnly Day, string DayOfWeek, List<OverrideItem> Items);

    private bool showModal;
    private DateOnly modalDate = DateOnly.FromDateTime(DateTime.Today);

    private string PackageTitle { get; } = "Зміни з 21 по 25 квітня 2025";

    private List<DayColumnItem> Columns { get; } = new()
    {
        new(new DateOnly(2025, 4, 21), "ПН 21.04", new()
        {
            new("1", "К-41", "3-5", "Практика",   "Тітянкин С.С.", null),
            new("2", "К-31", "1",   "Опер. системы", "Тітянкин С.С.", null),
        }),
        new(new DateOnly(2025, 4, 22), "ВТ 22.04", new()
        {
            new("3", "К-41", "3-5", "Практика", "Тітянкин С.С.", null),
            new("4", "К-31", "1",   "Опер. системы", "Тітянкин С.С.", null),
        }),
        new(new DateOnly(2025, 4, 23), "СР 23.04", new()
        {
            new("5", "К-41", "3-5", "Практика", "Тітянкин С.С.", null),
            new("6", "К-31", "1",   "Опер. системы", "Тітянкин С.С.", null),
        }),
        new(new DateOnly(2025, 4, 24), "ЧТ 24.04", new()
        {
            new("7", "К-41", "3-5", "Практика", "Тітянкин С.С.", null),
        }),
        new(new DateOnly(2025, 4, 25), "ПТ 25.04", new()
        {
            new("8", "К-41", "3-5", "Практика", "Тітянкин С.С.", null),
        }),
    };

    private int TotalCount => Columns.Sum(c => c.Items.Count);
    private int GroupCount => Columns.SelectMany(c => c.Items).Select(i => i.Group).Distinct().Count();

    private void AddOverride(DateOnly date)
    {
        modalDate = date;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private void RemoveOverride(string id)
    {
        foreach (var col in Columns)
        {
            col.Items.RemoveAll(i => i.Id == id);
        }
    }

    private void DuplicateOverride(OverrideItem item, DateOnly fromDay)
    {
        var nextId = Guid.NewGuid().ToString("N")[..8];
        foreach (var col in Columns.Where(c => c.Day != fromDay))
        {
            col.Items.Add(item with { Id = nextId + col.Day.Day });
        }
    }

    private void CopyDay(DateOnly fromDay)
    {
        var source = Columns.FirstOrDefault(c => c.Day == fromDay);
        if (source is null) return;

        foreach (var col in Columns.Where(c => c.Day != fromDay))
        {
            col.Items.Clear();
            foreach (var item in source.Items)
            {
                col.Items.Add(item with { Id = Guid.NewGuid().ToString("N")[..8] });
            }
        }
    }

    private void PublishAll() { }
}
