@inject Localizer L

<div class="group relative p-2.5 rounded-lg
            bg-white dark:bg-zinc-950
            border border-slate-200 dark:border-zinc-800
            hover:border-slate-300 dark:hover:border-zinc-700
            transition-colors">

    <div class="flex items-start justify-between gap-2 mb-1.5">
        <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold
                     bg-blue-500/10 text-blue-600 dark:text-blue-400">
            @Item.Group
        </span>
        <span class="text-[10px] font-mono text-slate-400 dark:text-zinc-600 tabular-nums">
            @Item.Pairs п.
        </span>
    </div>

    <p class="text-xs font-medium text-slate-700 dark:text-zinc-300 leading-tight mb-0.5 truncate">
        @Item.Action
    </p>

    <p class="text-[11px] text-slate-500 dark:text-zinc-500 leading-tight truncate">
        @Item.Target
    </p>

    @* Кнопки при hover *@
    <div class="absolute top-1 right-1 flex items-center gap-0.5
                opacity-0 group-hover:opacity-100 transition-opacity">
        <button @onclick="OnDuplicate"
                title="@L["weekDesk.duplicate"]"
                class="w-5 h-5 rounded flex items-center justify-center
                       bg-white/90 dark:bg-zinc-900/90
                       text-slate-400 dark:text-zinc-500
                       hover:text-blue-500 dark:hover:text-blue-400
                       hover:bg-blue-500/10 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
            </svg>
        </button>
        <button @onclick="OnRemove"
                title="@L["common.delete"]"
                class="w-5 h-5 rounded flex items-center justify-center
                       bg-white/90 dark:bg-zinc-900/90
                       text-slate-400 dark:text-zinc-500
                       hover:text-red-500 dark:hover:text-red-400
                       hover:bg-red-500/10 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public WeekDeskPage.OverrideItem Item { get; set; } = default!;

    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public EventCallback OnDuplicate { get; set; }
}
