@inject Localizer L

<div class="flex flex-col rounded-xl border border-slate-200 dark:border-zinc-800
            bg-white dark:bg-zinc-900/40 overflow-hidden min-h-[300px]">

    <div class="flex items-center justify-between px-3 py-2
                border-b border-slate-200 dark:border-zinc-800
                bg-slate-50/60 dark:bg-zinc-900/60">
        <div class="flex items-center gap-2 min-w-0">
            <span class="text-xs font-semibold text-slate-700 dark:text-zinc-300 truncate">
                @DayOfWeek
            </span>
            @if (Items.Count > 0)
            {
                <span class="shrink-0 px-1.5 py-0.5 rounded
                             bg-blue-500/10 text-blue-600 dark:text-blue-400
                             text-[10px] font-medium tabular-nums">
                    @Items.Count
                </span>
            }
        </div>
        <button @onclick="OnCopyDay"
                title="@L["weekDesk.copyDay"]"
                class="shrink-0 w-6 h-6 rounded flex items-center justify-center
                       text-slate-400 dark:text-zinc-600
                       hover:bg-slate-200 dark:hover:bg-zinc-800
                       hover:text-slate-700 dark:hover:text-zinc-300 transition-colors">
            <DocumentDuplicateIcon class="w-3.5 h-3.5" />
        </button>
    </div>

    <div class="flex-1 p-2 space-y-2">
        @if (Items.Count == 0)
        {
            <button @onclick="OnAdd"
                    class="w-full py-6 rounded-lg border-2 border-dashed
                           border-slate-200 dark:border-zinc-800
                           text-slate-400 dark:text-zinc-600
                           hover:border-blue-500/40 hover:text-blue-500 dark:hover:text-blue-400
                           transition-colors">
                <PlusIcon class="w-5 h-5 mx-auto mb-1" />
                <span class="text-xs">@L["weekDesk.add"]</span>
            </button>
        }
        else
        {
            @foreach (var item in Items)
            {
                <OverrideCardMini Item="item"
                                  OnRemove="() => OnRemove.InvokeAsync(item.Id)"
                                  OnDuplicate="() => OnDuplicate.InvokeAsync(item)" />
            }

            <button @onclick="OnAdd"
                    title="@L["weekDesk.add"]"
                    class="w-full py-1.5 rounded-lg border border-dashed
                           border-slate-200 dark:border-zinc-800
                           text-slate-400 dark:text-zinc-600
                           hover:border-blue-500/40 hover:text-blue-500 dark:hover:text-blue-400
                           transition-colors flex items-center justify-center">
                <PlusIcon class="w-3.5 h-3.5" />
            </button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public DateOnly Day { get; set; }
    [Parameter, EditorRequired] public string DayOfWeek { get; set; } = "";
    [Parameter, EditorRequired] public List<WeekDeskPage.OverrideItem> Items { get; set; } = new();

    [Parameter] public EventCallback OnAdd { get; set; }
    [Parameter] public EventCallback<string> OnRemove { get; set; }
    [Parameter] public EventCallback<WeekDeskPage.OverrideItem> OnDuplicate { get; set; }
    [Parameter] public EventCallback OnCopyDay { get; set; }
}
