<div>
    @* Заголовок с месяцем и стрелками *@
    <div class="flex items-center justify-between px-3 py-2 border-b border-slate-200 dark:border-zinc-800">
        <button class="w-7 h-7 rounded-lg text-slate-500 dark:text-zinc-500
                       hover:bg-slate-100 dark:hover:bg-zinc-800
                       hover:text-slate-900 dark:hover:text-zinc-100
                       flex items-center justify-center transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
            </svg>
        </button>
        <span class="text-sm font-semibold">Октябрь 2025</span>
        <button class="w-7 h-7 rounded-lg text-slate-500 dark:text-zinc-500
                       hover:bg-slate-100 dark:hover:bg-zinc-800
                       hover:text-slate-900 dark:hover:text-zinc-100
                       flex items-center justify-center transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
        </button>
    </div>

    @* Дни недели *@
    <div class="grid grid-cols-7 bg-slate-50/60 dark:bg-zinc-900/60 border-b border-slate-200 dark:border-zinc-800">
        @foreach (var d in Weekdays)
        {
            <div class="py-1.5 text-center text-[10px] font-semibold text-slate-500 dark:text-zinc-500 uppercase tracking-wider">
                @d
            </div>
        }
    </div>

    @* Сетка чисел *@
    <div class="grid grid-cols-7 gap-0.5 p-1.5">
        @foreach (var cell in Cells)
        {
            @if (cell.DayNumber == 0)
            {
                <div class="aspect-square"></div>
            }
            else
            {
                <button @onclick="() => OnDayClick.InvokeAsync(cell.Date)"
                        class="relative aspect-square rounded-lg text-sm font-medium
                               flex items-center justify-center tabular-nums
                               transition-all duration-150
                               @(cell.IsSelected
                                   ? "bg-blue-500 text-white shadow-md shadow-blue-500/30"
                                   : "text-slate-700 dark:text-zinc-300 hover:bg-slate-100 dark:hover:bg-zinc-800")">
                    @cell.DayNumber

                    @if (cell.HasReplacements && !cell.IsSelected)
                    {
                        <span class="absolute bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-amber-500"></span>
                    }
                    @if (cell.IsToday && !cell.IsSelected)
                    {
                        <span class="absolute top-1 right-1 w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    }
                </button>
            }
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback<DateOnly> OnDayClick { get; set; }

    private sealed record Cell(DateOnly Date, int DayNumber, bool IsSelected, bool IsToday, bool HasReplacements);

    private string[] Weekdays = { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс" };

    private List<Cell> Cells { get; } = BuildOctober2025();

    private static List<Cell> BuildOctober2025()
    {
        // Октябрь 2025: 1-е — среда. В сетке с Пн-первым это 3-я ячейка.
        var result = new List<Cell>();
        var empty = new Cell(default, 0, false, false, false);
        result.Add(empty);
        result.Add(empty);

        for (int day = 1; day <= 31; day++)
        {
            var date = new DateOnly(2025, 10, day);
            result.Add(new Cell(
                date,
                day,
                IsSelected: day == 14,
                IsToday: day == 14,
                HasReplacements: day == 14 || day == 16));
        }

        while (result.Count < 35)
        {
            result.Add(empty);
        }

        return result;
    }
}