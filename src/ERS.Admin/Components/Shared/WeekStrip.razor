@inject Localizer L

<div class="grid grid-cols-7">
    @foreach (var day in Days)
    {
        <button @onclick="() => OnDayClick.InvokeAsync(day.Date)"
                class="relative flex flex-col items-center gap-1 py-3
                       hover:bg-slate-50 dark:hover:bg-zinc-800/40 transition-colors
                       @(day.IsSelected ? "bg-blue-500/10" : "")">
            <span class="text-[10px] font-medium text-slate-500 dark:text-zinc-500 uppercase tracking-wider">
                @L.DayOfWeekShort(day.Date.DayOfWeek)
            </span>
            <span class="text-lg font-semibold tabular-nums @(day.IsSelected ? "text-blue-600 dark:text-blue-400" : "text-slate-700 dark:text-zinc-200")">
                @day.Date.Day
            </span>
            @if (day.HasReplacements)
            {
                <span class="absolute top-2 right-2 w-1.5 h-1.5 rounded-full bg-amber-500"></span>
            }
            @if (day.IsToday && !day.IsSelected)
            {
                <span class="absolute top-2 right-2 w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            }
            @if (day.IsSelected)
            {
                <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-8 h-0.5 rounded-full bg-blue-500"></span>
            }
        </button>
    }
</div>

@code {
    [Parameter] public EventCallback<DateOnly> OnDayClick { get; set; }

    private sealed record DayInfo(DateOnly Date, bool IsToday, bool IsSelected, bool HasReplacements);

    private List<DayInfo> Days { get; } = BuildWeek();

    private static List<DayInfo> BuildWeek()
    {
        var monday = new DateOnly(2025, 10, 13);

        return Enumerable.Range(0, 7).Select(i =>
        {
            var d = monday.AddDays(i);
            return new DayInfo(
                d,
                IsToday: d.Day == 14,
                IsSelected: d.Day == 14,
                HasReplacements: d.Day == 14 || d.Day == 16);
        }).ToList();
    }
}
