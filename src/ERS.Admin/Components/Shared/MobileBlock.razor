@inject Localizer L

<div class="flex md:hidden fixed inset-0 z-[9999] flex-col items-center justify-center px-8
            bg-slate-50 dark:bg-zinc-950 text-center">

    <div class="w-16 h-16 rounded-2xl bg-slate-200 dark:bg-zinc-900
                flex items-center justify-center mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="1.8" stroke="currentColor"
             class="w-7 h-7 text-slate-500 dark:text-zinc-500">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
        </svg>
    </div>

    <h1 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-zinc-100 mb-2">
        @L["mobile.title"]
    </h1>
    <p class="text-sm text-slate-500 dark:text-zinc-500 max-w-xs leading-relaxed">
        @L["mobile.description"]
    </p>
</div>
