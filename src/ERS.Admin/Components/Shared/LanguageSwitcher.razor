@inject Localizer L
@inject IJSRuntime JS

@if (Compact)
{
    <button @onclick="ToggleLanguage"
            title="@(L.Current == Language.En ? "EN" : "UK")"
            class="w-8 h-8 rounded-lg flex items-center justify-center
                   text-[11px] font-bold
                   text-slate-500 dark:text-zinc-400
                   hover:bg-slate-100 dark:hover:bg-zinc-800
                   hover:text-slate-900 dark:hover:text-zinc-100
                   transition-colors">
        @(L.Current == Language.En ? "EN" : "UK")
    </button>
}
else
{
    <div class="inline-flex rounded-lg border border-slate-200 dark:border-zinc-800 p-0.5
                bg-slate-50 dark:bg-zinc-950">
        <button @onclick="() => SetLang(Language.En)"
                class="px-2 py-1 rounded-md text-[11px] font-semibold transition-all duration-200
                       @(L.Current == Language.En
                           ? "bg-white dark:bg-zinc-800 text-slate-900 dark:text-zinc-100 shadow-sm"
                           : "text-slate-500 dark:text-zinc-500 hover:text-slate-900 dark:hover:text-zinc-200")">
            EN
        </button>
        <button @onclick="() => SetLang(Language.Uk)"
                class="px-2 py-1 rounded-md text-[11px] font-semibold transition-all duration-200
                       @(L.Current == Language.Uk
                           ? "bg-white dark:bg-zinc-800 text-slate-900 dark:text-zinc-100 shadow-sm"
                           : "text-slate-500 dark:text-zinc-500 hover:text-slate-900 dark:hover:text-zinc-200")">
            UK
        </button>
    </div>
}

@code {
    [Parameter] public bool Compact { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "ers-lang");

        if (!string.IsNullOrEmpty(stored))
        {
            L.SetLanguage(Localizer.ParseLanguage(stored));
        }
        else
        {
            var browserLang = await JS.InvokeAsync<string>("ersAdminTheme.getBrowserLanguage");

            if (browserLang.StartsWith("uk", StringComparison.OrdinalIgnoreCase))
                L.SetLanguage(Language.Uk);
            else
                L.SetLanguage(Language.En);
        }

        StateHasChanged();
    }

    private async Task ToggleLanguage()
    {
        var next = L.Current == Language.En ? Language.Uk : Language.En;
        await SetLang(next);
    }

    private async Task SetLang(Language lang)
    {
        if (L.Current == lang) return;

        await JS.InvokeVoidAsync("ersLoader.show");
        await Task.Delay(250);

        L.SetLanguage(lang);
        await JS.InvokeVoidAsync("localStorage.setItem", "ers-lang", Localizer.GetLanguageCode(lang));

        await Task.Delay(150);
        await JS.InvokeVoidAsync("ersLoader.hide");
    }
}
