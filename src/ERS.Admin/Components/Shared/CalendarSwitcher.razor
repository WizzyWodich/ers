@inject Localizer L

<div class="inline-flex rounded-lg border border-slate-200 dark:border-zinc-800 p-0.5 bg-slate-50 dark:bg-zinc-950">
    <button @onclick="() => OnToggle.InvokeAsync(false)"
            title="@L["calendar.week"]"
            class="px-2 py-1 rounded-md transition-all duration-200
                   @(!ShowMonth
                       ? "bg-white dark:bg-zinc-800 text-slate-900 dark:text-zinc-100 shadow-sm"
                       : "text-slate-400 dark:text-zinc-500 hover:text-slate-700 dark:hover:text-zinc-300")">
        <ViewColumnsIcon class="w-3.5 h-3.5" />
    </button>
    <button @onclick="() => OnToggle.InvokeAsync(true)"
            title="@L["calendar.month"]"
            class="px-2 py-1 rounded-md transition-all duration-200
                   @(ShowMonth
                       ? "bg-white dark:bg-zinc-800 text-slate-900 dark:text-zinc-100 shadow-sm"
                       : "text-slate-400 dark:text-zinc-500 hover:text-slate-700 dark:hover:text-zinc-300")">
        <CalendarDaysIcon class="w-3.5 h-3.5" />
    </button>
</div>

@code {
    [Parameter] public bool ShowMonth { get; set; }
    [Parameter] public EventCallback<bool> OnToggle { get; set; }
}
