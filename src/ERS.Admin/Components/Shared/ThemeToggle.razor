@inject IJSRuntime JS

<button @onclick="ToggleTheme"
        class="relative w-14 h-8 rounded-full transition-colors duration-300
               bg-slate-200 dark:bg-zinc-800
               hover:bg-slate-300 dark:hover:bg-zinc-700"
        title="Переключить тему">
    <span class="absolute top-1 left-1 w-6 h-6 rounded-full
                 bg-white dark:bg-zinc-950
                 shadow-md flex items-center justify-center
                 transition-transform duration-300
                 @(isDarkMode ? "translate-x-6" : "translate-x-0")">
        @if (isDarkMode)
        {
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 text-indigo-400">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
            </svg>
        }
        else
        {
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 text-amber-500">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
            </svg>
        }
    </span>
</button>

@code {
    private bool isDarkMode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Выполняем только один раз, после того как JS-рантайм готов
        if (!firstRender) return;

        var stored = await JS.InvokeAsync<string?>("ersAdminTheme.getStored");

        if (stored == "dark")
            isDarkMode = true;
        else if (string.IsNullOrEmpty(stored))
            isDarkMode = await JS.InvokeAsync<bool>("ersAdminTheme.isSystemDark");

        await JS.InvokeVoidAsync("ersAdminTheme.apply", isDarkMode);

        StateHasChanged(); 
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        await JS.InvokeVoidAsync("ersAdminTheme.applySmooth", isDarkMode);
        await JS.InvokeVoidAsync("ersAdminTheme.setStored", isDarkMode ? "dark" : "light");
    }
}