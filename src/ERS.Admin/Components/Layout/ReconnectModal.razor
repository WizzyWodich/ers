@inject Localizer L

<dialog id="components-reconnect-modal" class="ers-reconnect">
    <div class="ers-reconnect-inner">
        <div class="ers-reconnect-logo">ERS CRM Panel</div>

        <div class="ers-loader-dots">
            <span></span>
            <span></span>
            <span></span>
        </div>

        <p class="ers-reconnect-text">
            @L["reconnect.reconnecting"]
        </p>

        <button id="components-reconnect-button" class="ers-reconnect-retry">
            @L["reconnect.retry"]
        </button>
    </div>
</dialog>
