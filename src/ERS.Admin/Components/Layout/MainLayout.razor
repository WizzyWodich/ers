@inherits LayoutComponentBase
@implements IDisposable
@inject Localizer L

<MobileBlock />

<div @key="L.Current"
     class="h-screen flex bg-slate-50 dark:bg-zinc-950 text-slate-900 dark:text-zinc-100 transition-colors duration-300">

    <aside class="w-60 shrink-0 h-screen overflow-y-auto
                  border-r border-slate-200 dark:border-zinc-900
                  bg-white dark:bg-zinc-950 flex flex-col transition-colors">

        <div class="h-14 shrink-0 flex items-center gap-2.5 px-4 border-b border-slate-200 dark:border-zinc-900">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center">
                <CalendarDaysIcon class="w-4 h-4 text-white" />
            </div>
            <div class="min-w-0">
                <h1 class="text-sm font-semibold leading-tight">@L["layout.brand"]</h1>
                <p class="text-[10px] text-slate-500 dark:text-zinc-500 leading-tight">@L["layout.brandSubtitle"]</p>
            </div>
        </div>

        <NavMenu />

        <div class="shrink-0 border-t border-slate-200 dark:border-zinc-900 p-3 space-y-2">

            <div class="flex items-center justify-between px-2">
                <span class="text-xs text-slate-500 dark:text-zinc-500">@L["layout.language"]</span>
                <LanguageSwitcher />
            </div>

            <div class="flex items-center justify-between px-2">
                <span class="text-xs text-slate-500 dark:text-zinc-500">@L["layout.theme"]</span>
                <ThemeToggle />
            </div>

            <div class="flex items-center gap-2.5 px-2 py-1.5 rounded-lg
                        hover:bg-slate-100 dark:hover:bg-zinc-900 transition-colors cursor-pointer">
                <div class="w-7 h-7 rounded-full bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center text-[10px] font-semibold text-white">
                    ДС
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-xs font-medium truncate">@L["layout.dispatcher"]</p>
                    <p class="text-[10px] text-slate-500 dark:text-zinc-500 truncate">dispatcher@college.ua</p>
                </div>
            </div>
        </div>
    </aside>

    <main class="flex-1 min-w-0 h-screen overflow-y-auto">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        L.OnChange += OnLanguageChanged;
    }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.OnChange -= OnLanguageChanged;
    }
}
