@inject Localizer L

<div class="border border-slate-200 dark:border-zinc-800 rounded-xl overflow-hidden
            bg-white dark:bg-zinc-900/40">

    <div class="grid grid-cols-[72px_1fr_220px_120px_110px]
                bg-slate-50/80 dark:bg-zinc-900/60
                border-b border-slate-200 dark:border-zinc-800
                text-[10px] font-semibold text-slate-500 dark:text-zinc-500 uppercase tracking-wider">

        <div class="px-4 py-2.5">
            @L["table.pair"]
        </div>
        <div class="px-4 py-2.5 border-l border-slate-200 dark:border-zinc-800">
            @L["table.subject"]
        </div>
        <div class="px-4 py-2.5 border-l border-slate-200 dark:border-zinc-800">
            @L["table.teacher"]
        </div>
        <div class="px-4 py-2.5 border-l border-slate-200 dark:border-zinc-800">
            @L["table.room"]
        </div>
        <div class="px-4 py-2.5 border-l border-slate-200 dark:border-zinc-800 text-right">
            @L["table.action"]
        </div>
    </div>

    <div class="divide-y divide-slate-100 dark:divide-zinc-800/60">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
