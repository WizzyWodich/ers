@inject NavigationManager Nav
@inject Localizer L

<details class="relative group">
    <summary class="flex items-center gap-2.5 pl-3 pr-2 py-2 rounded-lg
                    bg-white dark:bg-zinc-900
                    border border-slate-200 dark:border-zinc-800
                    hover:bg-slate-50 dark:hover:bg-zinc-800
                    transition-colors cursor-pointer list-none
                    [&::-webkit-details-marker]:hidden">
        <div class="w-7 h-7 rounded-md bg-blue-500/15 flex items-center justify-center
                    text-[11px] font-bold text-blue-600 dark:text-blue-400">
            @Current.DisplayName
        </div>
        <span class="text-sm font-medium">@Current.DisplayName</span>
        <ChevronDownIcon class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500 transition-transform duration-200 group-open:rotate-180" />
    </summary>

    <div class="absolute left-0 mt-2 w-72 max-h-96 overflow-y-auto z-50
                rounded-xl bg-white dark:bg-zinc-900
                border border-slate-200 dark:border-zinc-800
                shadow-2xl shadow-black/10 dark:shadow-black/60">
        <div class="px-3 py-2 border-b border-slate-200 dark:border-zinc-800 sticky top-0
                    bg-white/95 dark:bg-zinc-900/95 backdrop-blur">
            <input type="text"
                   @bind="search"
                   @bind:event="oninput"
                   placeholder="@L["switcher.searchGroups"]"
                   class="w-full px-2.5 py-1.5 rounded-md text-sm
                          bg-slate-50 dark:bg-zinc-950
                          border border-slate-200 dark:border-zinc-800
                          placeholder-slate-400 dark:placeholder-zinc-500
                          focus:outline-none focus:border-blue-500/60" />
        </div>

        <div class="py-1">
            @if (Filtered.Count == 0)
            {
                <div class="px-3 py-4 text-center text-xs text-slate-400 dark:text-zinc-600">
                    @L["switcher.noGroups"]
                </div>
            }
            else
            {
                @foreach (var g in Filtered)
                {
                    <button @onclick="() => Switch(g.Id)"
                            class="w-full flex items-center gap-2.5 px-3 py-2 text-left
                                   hover:bg-slate-50 dark:hover:bg-zinc-800/70 transition-colors
                                   @(g.Id == Current.Id ? "bg-blue-500/10" : "")">
                        <div class="w-7 h-7 rounded-md flex items-center justify-center text-[11px] font-bold
                                    @(g.Id == Current.Id
                                        ? "bg-blue-500/20 text-blue-600 dark:text-blue-400"
                                        : "bg-slate-100 dark:bg-zinc-800 text-slate-500 dark:text-zinc-400")">
                            @g.DisplayName
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium truncate">@g.DisplayName</p>
                            <p class="text-[11px] text-slate-500 dark:text-zinc-500 truncate">@g.Specialty</p>
                        </div>
                        @if (g.Id == Current.Id)
                        {
                            <CheckIcon class="w-4 h-4 text-blue-600 dark:text-blue-400" />
                        }
                    </button>
                }
            }
        </div>
    </div>
</details>

@code {
    [Parameter, EditorRequired] public GroupItem Current { get; set; } = default!;
    [Parameter, EditorRequired] public List<GroupItem> Groups { get; set; } = new();

    private string search = "";

    private List<GroupItem> Filtered =>
        string.IsNullOrWhiteSpace(search)
            ? Groups
            : Groups.Where(g =>
                g.DisplayName.Contains(search, StringComparison.OrdinalIgnoreCase)
                || g.Specialty.Contains(search, StringComparison.OrdinalIgnoreCase))
              .ToList();

    private void Switch(string id)
    {
        search = "";
        Nav.NavigateTo($"/group/{id}");
    }

    public sealed record GroupItem(string Id, string DisplayName, string Specialty);
}
