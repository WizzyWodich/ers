@inject Localizer L

<div class="flex items-baseline gap-2">
    <span class="text-lg font-semibold">@DayOfWeek</span>
    <span class="text-sm text-slate-500 dark:text-zinc-500">@DateLabel</span>
</div>

<div class="ml-auto flex items-center gap-1">
    <button @onclick="() => OnPrev.InvokeAsync()"
            title="@L["nav.prev"]"
            class="w-9 h-9 rounded-lg flex items-center justify-center
                   bg-white dark:bg-zinc-900
                   border border-slate-200 dark:border-zinc-800
                   text-slate-500 dark:text-zinc-400
                   hover:bg-slate-50 dark:hover:bg-zinc-800
                   hover:text-slate-900 dark:hover:text-zinc-100 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
    </button>

    <button @onclick="() => OnToday.InvokeAsync()"
            class="px-3 h-9 rounded-lg text-sm font-medium
                   bg-white dark:bg-zinc-900
                   border border-slate-200 dark:border-zinc-800
                   text-slate-700 dark:text-zinc-300
                   hover:bg-slate-50 dark:hover:bg-zinc-800 transition-colors">
        @L["nav.today"]
    </button>

    <button @onclick="() => OnNext.InvokeAsync()"
            title="@L["nav.next"]"
            class="w-9 h-9 rounded-lg flex items-center justify-center
                   bg-white dark:bg-zinc-900
                   border border-slate-200 dark:border-zinc-800
                   text-slate-500 dark:text-zinc-400
                   hover:bg-slate-50 dark:hover:bg-zinc-800
                   hover:text-slate-900 dark:hover:text-zinc-100 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
    </button>
</div>

@code {
    [Parameter, EditorRequired] public string DayOfWeek { get; set; } = "";
    [Parameter, EditorRequired] public string DateLabel { get; set; } = "";

    [Parameter] public EventCallback OnPrev { get; set; }
    [Parameter] public EventCallback OnToday { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
}