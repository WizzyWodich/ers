@inject Localizer L

@if (IsOpen)
{
    <div class="fixed inset-0 z-40 bg-slate-900/30 dark:bg-black/30 animate-fade-in"
         style="backdrop-filter: blur(24px) saturate(80%); -webkit-backdrop-filter: blur(24px) saturate(80%);"
         @onclick="Close"></div>

    <div class="fixed inset-0 z-50 flex items-start justify-center p-4 pt-16 overflow-y-auto">

        <div class="relative w-full max-w-2xl rounded-2xl bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 shadow-2xl shadow-black/20 animate-modal-in">

            <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100 dark:border-zinc-800">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center">
                        <PlusIcon class="w-4 h-4 text-blue-600 dark:text-blue-400" />
                    </div>
                    <div>
                        <h2 class="text-base font-semibold leading-tight">@L["modal.title"]</h2>
                        <p class="text-xs text-slate-500 dark:text-zinc-500 leading-tight">@L["modal.subtitle"]</p>
                    </div>
                </div>
                <button @onclick="Close"
                        class="w-8 h-8 rounded-lg flex items-center justify-center
                               text-slate-400 dark:text-zinc-500
                               hover:bg-slate-100 dark:hover:bg-zinc-800
                               hover:text-slate-700 dark:hover:text-zinc-200 transition-colors">
                    <XMarkIcon class="w-4 h-4" />
                </button>
            </div>

            <div class="px-5 py-5 space-y-6">

                <section>
                    <div class="flex items-center justify-between mb-2">
                        <label class="text-xs font-semibold text-slate-500 dark:text-zinc-500 uppercase tracking-wider">
                            @L["modal.groups"]
                        </label>
                        <div class="flex items-center gap-1">
                            <button @onclick="SelectAllGroups"
                                    class="px-2 py-0.5 rounded text-[11px] font-medium
                                           text-slate-500 dark:text-zinc-400
                                           hover:bg-slate-100 dark:hover:bg-zinc-800 transition-colors">
                                @L["modal.selectAll"]
                            </button>
                            <button @onclick="ClearGroups"
                                    class="px-2 py-0.5 rounded text-[11px] font-medium
                                           text-slate-500 dark:text-zinc-400
                                           hover:bg-slate-100 dark:hover:bg-zinc-800 transition-colors">
                                @L["modal.clearAll"]
                            </button>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-1.5 p-3 rounded-lg bg-slate-50 dark:bg-zinc-950/60 border border-slate-200 dark:border-zinc-800 min-h-[44px]">
                        @foreach (var g in Groups)
                        {
                            var sel = SelectedGroupIds.Contains(g.Id);
                            <button @onclick="() => ToggleGroup(g.Id)"
                                    class="px-2.5 py-1 rounded-md text-xs font-medium transition-all duration-150
                                           @(sel
                                               ? "bg-blue-500 text-white shadow-sm shadow-blue-500/25"
                                               : "bg-white dark:bg-zinc-900 text-slate-600 dark:text-zinc-400 border border-slate-200 dark:border-zinc-800 hover:border-slate-300 dark:hover:border-zinc-700")">
                                @g.DisplayName
                            </button>
                        }
                    </div>
                    @if (SelectedGroupIds.Count == 0)
                    {
                        <p class="text-[11px] text-slate-400 dark:text-zinc-600 mt-1.5">
                            @L["modal.selectAtLeastOne"]
                        </p>
                    }
                </section>

                <section>
                    <label class="block text-xs font-semibold text-slate-500 dark:text-zinc-500 uppercase tracking-wider mb-2">
                        @L["modal.date"]
                    </label>
                    <input type="date"
                           value="@Date.ToString("yyyy-MM-dd")"
                           @onchange="OnDateChanged"
                           class="w-full px-3 py-2 rounded-lg text-sm
                                  bg-white dark:bg-zinc-950
                                  border border-slate-200 dark:border-zinc-800
                                  focus:outline-none focus:ring-2 focus:ring-blue-500/40 focus:border-blue-500/60
                                  transition-colors" />
                </section>

                <section>
                    <label class="block text-xs font-semibold text-slate-500 dark:text-zinc-500 uppercase tracking-wider mb-2">
                        @L["modal.pairs"]
                    </label>

                    <div class="inline-flex rounded-lg border border-slate-200 dark:border-zinc-800 p-0.5
                                bg-slate-50 dark:bg-zinc-950 mb-3">
                        <button type="button"
                                @onclick="() => isPairRange = false"
                                class="px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200
                                       @(!isPairRange
                                           ? "bg-white dark:bg-zinc-800 text-slate-900 dark:text-zinc-100 shadow-sm"
                                           : "text-slate-500 dark:text-zinc-500 hover:text-slate-900 dark:hover:text-zinc-200")">
                            @L["modal.pairOne"]
                        </button>
                        <button type="button"
                                @onclick="() => isPairRange = true"
                                class="px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200
                                       @(isPairRange
                                           ? "bg-white dark:bg-zinc-800 text-slate-900 dark:text-zinc-100 shadow-sm"
                                           : "text-slate-500 dark:text-zinc-500 hover:text-slate-900 dark:hover:text-zinc-200")">
                            @L["modal.pairRange"]
                        </button>
                    </div>

                    @if (!isPairRange)
                    {
                        <div class="flex items-center gap-2">
                            <span class="text-sm text-slate-500 dark:text-zinc-500">@L["modal.pairLabel"]</span>
                            <input type="number" min="1" max="7" @bind="PairFrom"
                                   class="w-20 px-3 py-2 rounded-lg text-sm
                                          bg-white dark:bg-zinc-950
                                          border border-slate-200 dark:border-zinc-800
                                          focus:outline-none focus:ring-2 focus:ring-blue-500/40" />
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-2">
                            <span class="text-sm text-slate-500 dark:text-zinc-500">@L["modal.from"]</span>
                            <input type="number" min="1" max="7" @bind="PairFrom"
                                   class="w-20 px-3 py-2 rounded-lg text-sm
                                          bg-white dark:bg-zinc-950
                                          border border-slate-200 dark:border-zinc-800
                                          focus:outline-none focus:ring-2 focus:ring-blue-500/40" />
                            <span class="text-sm text-slate-500 dark:text-zinc-500">@L["modal.to"]</span>
                            <input type="number" min="1" max="7" @bind="PairTo"
                                   class="w-20 px-3 py-2 rounded-lg text-sm
                                          bg-white dark:bg-zinc-950
                                          border border-slate-200 dark:border-zinc-800
                                          focus:outline-none focus:ring-2 focus:ring-blue-500/40" />
                        </div>
                    }
                </section>

                <section>
                    <label class="block text-xs font-semibold text-slate-500 dark:text-zinc-500 uppercase tracking-wider mb-2">
                        @L["modal.action"]
                    </label>
                    <div class="grid grid-cols-2 gap-1.5">
                        @foreach (var t in OverrideTypes)
                        {
                            var sel = OverrideType == t.Key;
                            <button @onclick="() => OverrideType = t.Key"
                                    class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-left border transition-all duration-150
                                           @(sel
                                               ? "bg-blue-500/10 border-blue-500/40 text-blue-700 dark:text-blue-400"
                                               : "bg-white dark:bg-zinc-950 border-slate-200 dark:border-zinc-800 text-slate-700 dark:text-zinc-300 hover:border-slate-300 dark:hover:border-zinc-700")">
                                @switch (t.IconKey)
                                {
                                    case "x":
                                        <XMarkIcon class="w-4 h-4 shrink-0" />
                                        break;
                                    case "user":
                                        <UserIcon class="w-4 h-4 shrink-0" />
                                        break;
                                    case "book":
                                        <BookOpenIcon class="w-4 h-4 shrink-0" />
                                        break;
                                    case "map":
                                        <MapPinIcon class="w-4 h-4 shrink-0" />
                                        break;
                                    case "arrow":
                                        <ArrowRightIcon class="w-4 h-4 shrink-0" />
                                        break;
                                    case "plus":
                                        <PlusIcon class="w-4 h-4 shrink-0" />
                                        break;
                                    case "sun":
                                        <SunIcon class="w-4 h-4 shrink-0" />
                                        break;
                                }
                                <span class="truncate">@L[t.LabelKey]</span>
                            </button>
                        }
                    </div>
                </section>

                @if (OverrideType == "SubstituteTeacher")
                {
                    <section class="space-y-3">
                        <label class="block text-xs font-semibold text-slate-500 dark:text-zinc-500 uppercase tracking-wider">
                            @L["override.substituteTeacher"]
                        </label>
                        <div>
                            <label class="block text-xs text-slate-500 dark:text-zinc-400 mb-1.5">@L["modal.oldTeacher"]</label>
                            <select @bind="OldTeacher" class="w-full px-3 py-2 rounded-lg text-sm bg-white dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800 focus:outline-none focus:ring-2 focus:ring-blue-500/40">
                                <option value="">@L["modal.notSpecified"]</option>
                                @foreach (var t in Teachers) { <option value="@t">@t</option> }
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs text-slate-500 dark:text-zinc-400 mb-1.5">@L["modal.newTeacher"]</label>
                            <select @bind="NewTeacher" class="w-full px-3 py-2 rounded-lg text-sm bg-white dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800 focus:outline-none focus:ring-2 focus:ring-blue-500/40">
                                <option value="">@L["modal.selectPlaceholder"]</option>
                                @foreach (var t in Teachers) { <option value="@t">@t</option> }
                            </select>
                        </div>
                    </section>
                }
                else if (OverrideType == "SubstituteSubject")
                {
                    <section class="space-y-3">
                        <label class="block text-xs font-semibold text-slate-500 dark:text-zinc-500 uppercase tracking-wider">
                            @L["override.substituteSubject"]
                        </label>
                        <div>
                            <label class="block text-xs text-slate-500 dark:text-zinc-400 mb-1.5">@L["modal.oldSubject"]</label>
                            <select @bind="OldSubject" class="w-full px-3 py-2 rounded-lg text-sm bg-white dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800 focus:outline-none focus:ring-2 focus:ring-blue-500/40">
                                <option value="">@L["modal.notSpecified"]</option>
                                @foreach (var s in Subjects) { <option value="@s">@s</option> }
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs text-slate-500 dark:text-zinc-400 mb-1.5">@L["modal.newSubject"]</label>
                            <select @bind="NewSubject" class="w-full px-3 py-2 rounded-lg text-sm bg-white dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800 focus:outline-none focus:ring-2 focus:ring-blue-500/40">
                                <option value="">@L["modal.selectPlaceholder"]</option>
                                @foreach (var s in Subjects) { <option value="@s">@s</option> }
                            </select>
                        </div>
                    </section>
                }
                else if (OverrideType == "SubstituteRoom")
                {
                    <section>
                        <label class="block text-xs font-semibold text-slate-500 dark:text-zinc-500 uppercase tracking-wider mb-2">@L["modal.newRoom"]</label>
                        <select @bind="NewRoom" class="w-full px-3 py-2 rounded-lg text-sm bg-white dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800 focus:outline-none focus:ring-2 focus:ring-blue-500/40">
                            <option value="">@L["modal.selectPlaceholder"]</option>
                            @foreach (var r in Rooms) { <option value="@r">@r</option> }
                        </select>
                    </section>
                }
                else if (OverrideType == "Move")
                {
                    <section>
                        <label class="block text-xs font-semibold text-slate-500 dark:text-zinc-500 uppercase tracking-wider mb-2">@L["override.move"]</label>
                        <div class="flex items-center gap-2">
                            <span class="text-sm text-slate-500 dark:text-zinc-500">@L["modal.moveTo"]</span>
                            <input type="number" min="1" max="7" @bind="MoveToPair"
                                   class="w-20 px-3 py-2 rounded-lg text-sm bg-white dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800 focus:outline-none focus:ring-2 focus:ring-blue-500/40" />
                        </div>
                    </section>
                }
                else if (OverrideType == "Add")
                {
                    <section class="space-y-3">
                        <label class="block text-xs font-semibold text-slate-500 dark:text-zinc-500 uppercase tracking-wider">@L["override.add"]</label>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs text-slate-500 dark:text-zinc-400 mb-1.5">@L["modal.subject"]</label>
                                <select @bind="NewSubject" class="w-full px-3 py-2 rounded-lg text-sm bg-white dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800 focus:outline-none focus:ring-2 focus:ring-blue-500/40">
                                    <option value="">@L["modal.selectPlaceholder"]</option>
                                    @foreach (var s in Subjects) { <option value="@s">@s</option> }
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs text-slate-500 dark:text-zinc-400 mb-1.5">@L["modal.teacherLabel"]</label>
                                <select @bind="NewTeacher" class="w-full px-3 py-2 rounded-lg text-sm bg-white dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800 focus:outline-none focus:ring-2 focus:ring-blue-500/40">
                                    <option value="">@L["modal.selectPlaceholder"]</option>
                                    @foreach (var t in Teachers) { <option value="@t">@t</option> }
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs text-slate-500 dark:text-zinc-400 mb-1.5">@L["modal.roomLabel"]</label>
                                <select @bind="NewRoom" class="w-full px-3 py-2 rounded-lg text-sm bg-white dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800 focus:outline-none focus:ring-2 focus:ring-blue-500/40">
                                    <option value="">@L["modal.selectPlaceholder"]</option>
                                    @foreach (var r in Rooms) { <option value="@r">@r</option> }
                                </select>
                            </div>
                        </div>
                    </section>
                }

                <section>
                    <label class="block text-xs font-semibold text-slate-500 dark:text-zinc-500 uppercase tracking-wider mb-2">
                        @L["modal.reason"]
                    </label>
                    <textarea @bind="Reason"
                              rows="2"
                              placeholder="@L["modal.reasonPlaceholder"]"
                              class="w-full px-3 py-2 rounded-lg text-sm resize-none
                                     bg-white dark:bg-zinc-950
                                     border border-slate-200 dark:border-zinc-800
                                     placeholder-slate-400 dark:placeholder-zinc-600
                                     focus:outline-none focus:ring-2 focus:ring-blue-500/40"></textarea>
                </section>
            </div>

            <div class="px-5 py-4 border-t border-slate-100 dark:border-zinc-800 space-y-3">
                @if (CanCreate)
                {
                    <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-blue-500/5 border border-blue-500/20 text-sm text-blue-700 dark:text-blue-400">
                        <InformationCircleIcon class="w-4 h-4 shrink-0" />
                        <span>@PreviewText</span>
                    </div>
                }

                <div class="flex items-center justify-end gap-2">
                    <button @onclick="Close"
                            class="px-4 py-2 rounded-lg text-sm font-medium
                                   text-slate-600 dark:text-zinc-400
                                   hover:bg-slate-100 dark:hover:bg-zinc-800 transition-colors">
                        @L["modal.cancel"]
                    </button>
                    <button @onclick="Create"
                            disabled="@(!CanCreate)"
                            class="px-4 py-2 rounded-lg text-sm font-medium transition-all duration-150
                                   @(CanCreate
                                       ? "bg-blue-500 hover:bg-blue-600 text-white shadow-lg shadow-blue-500/25"
                                       : "bg-slate-100 dark:bg-zinc-800 text-slate-400 dark:text-zinc-600 cursor-not-allowed")">
                        @L["modal.create"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string? PreGroupId { get; set; }
    [Parameter] public DateOnly? PreDate { get; set; }

    public sealed record GroupItem(string Id, string DisplayName);
    public sealed record OverrideTypeItem(string Key, string LabelKey, string IconKey);

    private List<GroupItem> Groups { get; } = new()
    {
        new("k21", "К-21"), new("k22", "К-22"), new("k41", "К-41"),
        new("b31", "Б-31"), new("b32", "Б-32"), new("p41", "П-41"),
        new("ag11", "Аг-11"), new("ag21", "Аг-21"),
        new("d11", "Д-11"), new("d21", "Д-21"),
        new("e31", "Е-31"), new("e32", "Е-32"),
    };

    private List<string> Teachers { get; } = new()
    {
        "Петров І.С.", "Сидоров О.В.", "Іванов П.П.", "Кузнєцова М.І.", "Смірнов Д.А."
    };

    private List<string> Subjects { get; } = new()
    {
        "Програмування", "Математика", "Фізкультура", "Історія", "ОБЖ", "Практика"
    };

    private List<string> Rooms { get; } = new()
    {
        "301", "302", "305", "Спортзал"
    };

    private List<OverrideTypeItem> OverrideTypes { get; } = new()
    {
        new("Cancel",            "override.cancel",            "x"),
        new("SubstituteTeacher", "override.substituteTeacher", "user"),
        new("SubstituteSubject", "override.substituteSubject", "book"),
        new("SubstituteRoom",    "override.substituteRoom",    "map"),
        new("Move",              "override.move",              "arrow"),
        new("Add",               "override.add",               "plus"),
        new("FreeDay",           "override.freeDay",           "sun"),
    };

    private HashSet<string> SelectedGroupIds { get; } = new();
    private DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    private bool isPairRange;
    private int PairFrom { get; set; } = 1;
    private int PairTo { get; set; } = 1;
    private string OverrideType { get; set; } = "Cancel";

    private string OldTeacher { get; set; } = "";
    private string NewTeacher { get; set; } = "";
    private string OldSubject { get; set; } = "";
    private string NewSubject { get; set; } = "";
    private string NewRoom { get; set; } = "";
    private int MoveToPair { get; set; } = 1;
    private string Reason { get; set; } = "";

    private bool _wasOpen;

    protected override void OnParametersSet()
    {
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            if (!string.IsNullOrEmpty(PreGroupId)) SelectedGroupIds.Add(PreGroupId);
            if (PreDate.HasValue) Date = PreDate.Value;
        }
        if (!IsOpen && _wasOpen) _wasOpen = false;
    }

    private void ToggleGroup(string id)
    {
        if (!SelectedGroupIds.Add(id)) SelectedGroupIds.Remove(id);
    }

    private void SelectAllGroups()
    {
        foreach (var g in Groups) SelectedGroupIds.Add(g.Id);
    }

    private void ClearGroups() => SelectedGroupIds.Clear();

    private void OnDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d)) Date = d;
    }

    private int PairsCount => isPairRange ? Math.Max(1, PairTo - PairFrom + 1) : 1;
    private int WillCreateCount => SelectedGroupIds.Count * PairsCount;

    private string PreviewText
    {
        get
        {
            var ow = WillCreateCount == 1 ? L["modal.overrideOne"] : L["modal.overrideMany"];
            var gw = SelectedGroupIds.Count == 1 ? L["modal.groupOne"] : L["modal.groupMany"];
            var text = $"{L["modal.willCreate"]}: {WillCreateCount} {ow} · {SelectedGroupIds.Count} {gw}";
            if (isPairRange && PairTo > PairFrom)
            {
                text += $" · {PairTo - PairFrom + 1} {L["modal.pairsWord"]}";
            }
            return text;
        }
    }

    private bool CanCreate =>
        SelectedGroupIds.Count > 0
        && PairFrom >= 1 && PairFrom <= 7
        && (!isPairRange || (PairTo >= PairFrom && PairTo <= 7));

    private void Close() => OnClose.InvokeAsync();
    private void Create() => Close();
}
