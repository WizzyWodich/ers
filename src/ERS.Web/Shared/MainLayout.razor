@inherits LayoutComponentBase
@implements IDisposable
@inject Localizer L

<div @key="L.Current"
     class="min-h-screen bg-slate-50 dark:bg-zinc-950 text-slate-900 dark:text-zinc-100 transition-colors duration-300 flex flex-col">

    <header class="sticky top-0 z-40 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-md
                   border-b border-slate-200/70 dark:border-zinc-900/70 transition-colors">
        <div class="max-w-full md:max-w-3xl lg:max-w-5xl xl:max-w-7xl mx-auto flex items-center justify-between px-4 lg:px-8 h-14 lg:h-16">

            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 lg:w-9 lg:h-9 rounded-lg bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center">
                    <CalendarDaysIcon class="w-4 h-4 lg:w-5 lg:h-5 text-white" />
                </div>
                <div>
                    <h1 class="text-sm lg:text-base font-semibold leading-tight">@L["layout.brand"]</h1>
                    <p class="text-[10px] lg:text-xs text-slate-500 dark:text-zinc-500 leading-tight">@L["layout.brandSubtitle"]</p>
                </div>
            </div>

            <div class="flex items-center gap-1 lg:gap-2">
                <LanguageSwitcher />
                <ThemeToggle />
                <ProfileMenu />
            </div>
        </div>
    </header>

    <main class="flex-1 w-full max-w-full md:max-w-3xl lg:max-w-5xl xl:max-w-7xl mx-auto px-4 lg:px-8 py-4 lg:py-8 pb-24">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        L.OnChange += OnLanguageChanged;
    }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.OnChange -= OnLanguageChanged;
    }
}