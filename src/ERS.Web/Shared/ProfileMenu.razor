<div class="relative">
    <button @onclick="ToggleMenu"
            class="flex items-center gap-2 pl-1 pr-2 py-1 rounded-full
                   hover:bg-slate-100 dark:hover:bg-zinc-900 transition-colors">
        <div class="w-7 h-7 rounded-full bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center text-[10px] font-semibold text-white">
            ВП
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
             class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500 hidden sm:block @(isOpen ? "rotate-180" : "") transition-transform">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg>
    </button>

    @if (isOpen)
    {
        <div class="absolute right-0 mt-2 w-64 rounded-xl bg-white dark:bg-zinc-900
                    border border-slate-200 dark:border-zinc-800 shadow-xl shadow-slate-900/5 dark:shadow-black/40
                    overflow-hidden z-30">
            @* Шапка профиля *@
            <div class="px-4 py-3 border-b border-slate-100 dark:border-zinc-800">
                <p class="text-sm font-semibold truncate">Волков Павел</p>
                <p class="text-xs text-slate-500 dark:text-zinc-500 truncate">pavel@college.ua</p>
                <p class="text-[10px] text-slate-400 dark:text-zinc-600 mt-1">Группа К-21 · 2 курс</p>
            </div>

            <div class="py-1">
                @* Профиль — отключён *@
                <button disabled
                        class="w-full flex items-center gap-2.5 px-4 py-2 text-sm text-left
                               text-slate-400 dark:text-zinc-600
                               cursor-not-allowed">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                    </svg>
                    <span class="flex-1">Профиль</span>
                    <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded
                                 bg-slate-100 dark:bg-zinc-800
                                 text-slate-500 dark:text-zinc-500
                                 text-[9px] font-medium uppercase tracking-wider">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-2.5 h-2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                        </svg>
                        Скоро
                    </span>
                </button>

                @* Уведомления — отключены *@
                <button disabled
                        class="w-full flex items-center gap-2.5 px-4 py-2 text-sm text-left
                               text-slate-400 dark:text-zinc-600
                               cursor-not-allowed">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
                    </svg>
                    <span class="flex-1">Уведомления</span>
                    <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded
                                 bg-slate-100 dark:bg-zinc-800
                                 text-slate-500 dark:text-zinc-500
                                 text-[9px] font-medium uppercase tracking-wider">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-2.5 h-2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                        </svg>
                        Скоро
                    </span>
                </button>

                @* Настройки — активны *@
                <button @onclick="OpenSettings"
                        class="w-full flex items-center gap-2.5 px-4 py-2 text-sm text-left
                               hover:bg-slate-50 dark:hover:bg-zinc-800/60 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-4 h-4 text-slate-400 dark:text-zinc-500">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    </svg>
                    <span class="flex-1">Настройки</span>
                </button>
            </div>

            <div class="border-t border-slate-100 dark:border-zinc-800 py-1">
                <button class="w-full flex items-center gap-2.5 px-4 py-2 text-sm text-left
                               text-red-600 dark:text-red-400
                               hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75" />
                    </svg>
                    Выйти
                </button>
            </div>
        </div>
    }
</div>

@* Модалка настроек *@
@if (showSettings)
{
    <SettingsModal OnClose="CloseSettings" />
}

@code {
    private bool isOpen;
    private bool showSettings;

    private void ToggleMenu() => isOpen = !isOpen;

    private void OpenSettings()
    {
        isOpen = false;
        showSettings = true;
    }

    private void CloseSettings() => showSettings = false;
}