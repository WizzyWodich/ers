@inject Localizer L
@inject IJSRuntime JS

<button @onclick="ToggleLanguage"
        class="w-9 h-9 rounded-lg flex items-center justify-center
               text-xs font-bold
               text-slate-500 dark:text-zinc-400
               hover:bg-slate-100 dark:hover:bg-zinc-800
               hover:text-slate-900 dark:hover:text-zinc-100
               transition-colors">
    @(L.Current == Language.En ? "EN" : "UK")
</button>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "ers-lang");
        
        if (!string.IsNullOrEmpty(stored))
        {
            L.SetLanguage(Localizer.ParseLanguage(stored));
        }
        else
        {
            var browserLang = await JS.InvokeAsync<string>("ersTheme.getBrowserLanguage");
            L.SetLanguage(browserLang.StartsWith("uk", StringComparison.OrdinalIgnoreCase) ? Language.Uk : Language.En);
        }
        StateHasChanged();
    }

    private async Task ToggleLanguage()
    {
        var next = L.Current == Language.En ? Language.Uk : Language.En;
        L.SetLanguage(next);
        await JS.InvokeVoidAsync("localStorage.setItem", "ers-lang", Localizer.GetLanguageCode(next));
    }
}