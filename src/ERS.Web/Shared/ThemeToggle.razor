@inject IJSRuntime JS
@inject Localizer L

<button @onclick="ToggleTheme"
        class="w-9 h-9 rounded-lg flex items-center justify-center
               text-slate-500 dark:text-zinc-400
               hover:bg-slate-100 dark:hover:bg-zinc-800
               hover:text-slate-900 dark:hover:text-zinc-100
               transition-colors"
        title="@L["theme.toggle"]">
    @if (isDarkMode)
    {
        <MoonIcon class="w-5 h-5 text-indigo-400" />
    }
    else
    {
        <SunIcon class="w-5 h-5 text-amber-500" />
    }
</button>

@code {
    private bool isDarkMode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var stored = await JS.InvokeAsync<string?>("ersTheme.getStored");
        
        if (stored == "dark") isDarkMode = true;
        else if (stored == "light") isDarkMode = false;
        else isDarkMode = await JS.InvokeAsync<bool>("ersTheme.isSystemDark");

        await JS.InvokeVoidAsync("ersTheme.apply", isDarkMode);
        StateHasChanged();
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        await JS.InvokeVoidAsync("ersTheme.applySmooth", isDarkMode);
        await JS.InvokeVoidAsync("ersTheme.setStored", isDarkMode ? "dark" : "light");
    }
}