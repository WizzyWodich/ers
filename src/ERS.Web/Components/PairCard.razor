@inject Localizer L

<div class="group relative flex gap-3 lg:gap-4 p-3.5 lg:p-4 rounded-2xl 
            bg-white/80 dark:bg-zinc-900/60
            border border-slate-200/70 dark:border-zinc-800/50
            shadow-sm hover:shadow-md lg:hover:-translate-y-0.5
            transition-all duration-200 w-full border-l-4 border-l-@(Color)-500">

    <div class="flex flex-col items-center justify-center w-12 lg:w-14 shrink-0">
        <span class="text-[9px] lg:text-[10px] font-medium text-slate-400 uppercase tracking-wider">@L["table.pair"]</span>
        <span class="text-xl lg:text-2xl font-bold leading-none mt-0.5">@Number</span>
        <span class="text-[10px] lg:text-xs font-mono mt-1 text-slate-500">@Start</span>
        <span class="text-[10px] lg:text-xs font-mono text-slate-400">@End</span>
    </div>

    <div class="w-px bg-slate-200 dark:bg-zinc-800 self-stretch my-1"></div>

    <div class="flex-1 min-w-0 flex flex-col justify-center">
        <div class="flex items-start justify-between gap-2">
            <p class="font-semibold text-sm lg:text-base truncate @(Status == "Cancelled" ? "line-through opacity-50" : "")">
                @Subject
            </p>
            @if (Status == "Substituted")
            {
                <span class="shrink-0 inline-flex items-center px-1.5 py-0.5 rounded
                             bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 text-[9px] lg:text-[10px] font-medium uppercase tracking-wider">
                    @L["table.substitution"]
                </span>
            }
        </div>

        <div class="mt-1 text-xs lg:text-sm text-slate-500 dark:text-zinc-400">
            @if (Status == "Substituted" && !string.IsNullOrEmpty(OldTeacher))
            {
                <div class="flex items-center gap-1.5 text-amber-600 dark:text-amber-400">
                    <span class="line-through opacity-50">@OldTeacher</span>
                    <ArrowRightIcon class="w-3 h-3" />
                    <span class="font-medium">@Teacher</span>
                </div>
            }
            else
            {
                <p class="truncate">@Teacher</p>
            }
            <p class="truncate mt-0.5">@L["table.room"]: @Room</p>
        </div>
    </div>
</div>

@code {
    [Parameter] public int Number { get; set; }
    [Parameter] public string Start { get; set; } = "";
    [Parameter] public string End { get; set; } = "";
    [Parameter] public string Subject { get; set; } = "";
    [Parameter] public string Teacher { get; set; } = "";
    [Parameter] public string? OldTeacher { get; set; }
    [Parameter] public string Room { get; set; } = "";
    [Parameter] public string Color { get; set; } = "blue"; 
    [Parameter] public string Status { get; set; } = "Normal"; 
}