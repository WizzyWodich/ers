@* Карточка одной пары *@

<div class="group relative flex gap-3 p-3 rounded-2xl bg-white dark:bg-slate-800/60
            border border-slate-200/70 dark:border-slate-700/50
            shadow-sm hover:shadow-md hover:-translate-y-0.5
            transition-all duration-200 @AccentClass @DimClass">

    @* Номер пары и время *@
    <div class="flex flex-col items-center justify-center w-14 shrink-0">
        <span class="text-[10px] font-medium text-slate-400 dark:text-slate-500 uppercase tracking-wider">пара</span>
        <span class="text-2xl font-bold leading-none @NumberColorClass">@Number</span>
        <span class="text-[10px] font-mono mt-1 text-slate-500 dark:text-slate-400">@Start</span>
        <span class="text-[10px] font-mono text-slate-400 dark:text-slate-500">@End</span>
    </div>

    @* Разделитель *@
    <div class="w-px bg-slate-200 dark:bg-slate-700 self-stretch my-1"></div>

    @* Контент *@
    <div class="flex-1 min-w-0 py-0.5">
        <div class="flex items-start justify-between gap-2">
            <p class="font-semibold text-[15px] leading-tight truncate @TitleClass">
                @Subject
            </p>

            @* Бейдж статуса *@
            @if (Status == "Cancelled")
            {
                <span class="shrink-0 inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md
                             bg-red-100 dark:bg-red-950/50 text-red-600 dark:text-red-400
                             text-[10px] font-medium">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                    Отменено
                </span>
            }
            else if (Status == "Substituted")
            {
                <span class="shrink-0 inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md
                             bg-amber-100 dark:bg-amber-950/50 text-amber-700 dark:text-amber-400
                             text-[10px] font-medium">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                    </svg>
                    Замена
                </span>
            }
            else if (Status == "Added")
            {
                <span class="shrink-0 inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md
                             bg-emerald-100 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400
                             text-[10px] font-medium">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Доп.
                </span>
            }
        </div>

        <div class="flex items-center gap-3 mt-1.5 text-xs text-slate-600 dark:text-slate-400">
            @if (!string.IsNullOrEmpty(Teacher))
            {
                <span class="inline-flex items-center gap-1 truncate">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3 shrink-0">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                    </svg>
                    <span class="truncate">@Teacher</span>
                </span>
            }
            @if (!string.IsNullOrEmpty(Room))
            {
                <span class="inline-flex items-center gap-1 truncate">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3 shrink-0">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                    </svg>
                    <span class="truncate">@Room</span>
                </span>
            }
        </div>

        @if (!string.IsNullOrEmpty(Reason))
        {
            <p class="mt-1.5 text-[11px] text-slate-500 dark:text-slate-500 italic truncate">@Reason</p>
        }
    </div>
</div>

@code {
    [Parameter] public int Number { get; set; }
    [Parameter] public string Start { get; set; } = "";
    [Parameter] public string End { get; set; } = "";
    [Parameter] public string Subject { get; set; } = "";
    [Parameter] public string? Teacher { get; set; }
    [Parameter] public string? Room { get; set; }
    [Parameter] public string Status { get; set; } = "Normal";
    [Parameter] public string? Reason { get; set; }
    [Parameter] public string Color { get; set; } = "blue";

    private string AccentClass => Color switch
    {
        "blue"    => "border-l-4 border-l-blue-500",
        "purple"  => "border-l-4 border-l-purple-500",
        "pink"    => "border-l-4 border-l-pink-500",
        "red"     => "border-l-4 border-l-red-500",
        "orange"  => "border-l-4 border-l-orange-500",
        "amber"   => "border-l-4 border-l-amber-500",
        "green"   => "border-l-4 border-l-emerald-500",
        "teal"    => "border-l-4 border-l-teal-500",
        "cyan"    => "border-l-4 border-l-cyan-500",
        _         => "border-l-4 border-l-slate-500"
    };

    private string NumberColorClass => Status == "Cancelled"
        ? "text-slate-400 dark:text-slate-600"
        : Color switch
        {
            "blue"    => "text-blue-600 dark:text-blue-400",
            "purple"  => "text-purple-600 dark:text-purple-400",
            "pink"    => "text-pink-600 dark:text-pink-400",
            "red"     => "text-red-600 dark:text-red-400",
            "orange"  => "text-orange-600 dark:text-orange-400",
            "amber"   => "text-amber-600 dark:text-amber-400",
            "green"   => "text-emerald-600 dark:text-emerald-400",
            "teal"    => "text-teal-600 dark:text-teal-400",
            "cyan"    => "text-cyan-600 dark:text-cyan-400",
            _         => "text-slate-600 dark:text-slate-400"
        };

    private string TitleClass => Status == "Cancelled"
        ? "text-slate-400 dark:text-slate-600 line-through"
        : "text-slate-900 dark:text-slate-100";

    private string DimClass => Status == "Cancelled"
        ? "opacity-60"
        : "";
}