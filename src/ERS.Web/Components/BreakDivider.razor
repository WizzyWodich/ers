@inject Localizer L

<div class="relative flex items-center py-1 px-2 lg:px-4">
    
    <div class="flex-1 h-px bg-slate-200 dark:bg-zinc-800/60"></div>

    <div class="flex items-center gap-2 px-3 shrink-0">
        <ClockIcon class="@($"w-3.5 h-3.5 {IconColorClass}")" />
        <span class="@($"text-[10px] lg:text-xs font-medium uppercase tracking-wider {TextColorClass}")">
            @(Type == "Big" ? L["bells.bigBreak"] : L["bells.break"]) · @Duration @L["bells.min"]
        </span>
    </div>

    <div class="flex-1 h-px bg-slate-200 dark:bg-zinc-800/60"></div>
</div>

@code {
    [Parameter] public int Duration { get; set; }
    
    [Parameter] public string Type { get; set; } = "Small"; 

    private string IconColorClass => Type == "Big" ? "text-violet-500" : "text-blue-500";
    
    private string TextColorClass => Type == "Big" 
        ? "text-violet-600 dark:text-violet-400" 
        : "text-blue-600 dark:text-blue-400/80";
}