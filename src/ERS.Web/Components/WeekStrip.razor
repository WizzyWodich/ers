@inject Localizer L

<div class="grid grid-cols-7">
    @foreach (var date in Days)
    {
        var isSelected = date == SelectedDate;
        var isToday = date == Today;
        var hasReplacements = date.Day == 14 || date.Day == 16; // мок

        <button @onclick="() => OnDayClick.InvokeAsync(date)"
                class="relative flex flex-col items-center gap-0.5 py-1.5
                       hover:bg-slate-50 dark:hover:bg-zinc-800/40 transition-colors
                       @(isSelected ? "bg-blue-500/10" : "")">
            <span class="text-[9px] font-medium text-slate-500 dark:text-zinc-500 uppercase tracking-wider">
                @L.DayOfWeekShort(date.DayOfWeek)
            </span>
            <span class="text-base font-semibold tabular-nums @(isSelected ? "text-blue-600 dark:text-blue-400" : "text-slate-700 dark:text-zinc-200")">
                @date.Day
            </span>
            @if (hasReplacements)
            {
                <span class="absolute top-1 right-1.5 w-1 h-1 rounded-full bg-amber-500"></span>
            }
            @if (isToday && !isSelected)
            {
                <span class="absolute top-1 right-1.5 w-1 h-1 rounded-full bg-emerald-500"></span>
            }
            @if (isSelected)
            {
                <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-6 h-0.5 rounded-full bg-blue-500"></span>
            }
        </button>
    }
</div>

@code {
    [Parameter] public EventCallback<DateOnly> OnDayClick { get; set; }
    [Parameter] public DateOnly SelectedDate { get; set; }

    private DateOnly Today { get; } = new(2025, 10, 14);

    private List<DateOnly> Days { get; } = BuildWeek();

    private static List<DateOnly> BuildWeek()
    {
        var monday = new DateOnly(2025, 10, 13);
        return Enumerable.Range(0, 7).Select(i => monday.AddDays(i)).ToList();
    }
}