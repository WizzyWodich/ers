@page "/not-found"
@inject Localizer L

<PageTitle>@L["notFound.title"]</PageTitle>

<div class="relative min-h-screen flex items-center justify-center overflow-hidden
            bg-slate-50 dark:bg-zinc-950 transition-colors duration-300">

    <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-[10%] -left-[10%] w-[40vw] h-[40vw] max-w-[600px] max-h-[600px]
                    rounded-full bg-slate-300/30 dark:bg-zinc-800/30 filter blur-[100px] animate-blob"></div>
        <div class="absolute top-[20%] -right-[10%] w-[35vw] h-[35vw] max-w-[500px] max-h-[500px]
                    rounded-full bg-blue-400/10 dark:bg-blue-600/10 filter blur-[100px] animate-blob animation-delay-2000"></div>
    </div>

    <div class="relative z-10 w-full max-w-md px-4 text-center animate-slide-up">

        @* Иконка *@
        <div class="w-24 h-24 mx-auto rounded-3xl bg-white dark:bg-zinc-900 shadow-xl shadow-slate-200/50 dark:shadow-black/30
                    border border-slate-100 dark:border-zinc-800
                    flex items-center justify-center mb-8 rotate-3">
            <MapPinIcon class="w-10 h-10 text-slate-400 dark:text-zinc-500" />
        </div>

        <h1 class="text-7xl font-black text-transparent bg-clip-text bg-gradient-to-br from-slate-800 to-slate-400 dark:from-zinc-100 dark:to-zinc-600 mb-2">
            404
        </h1>
        
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-zinc-100 mb-3">
            @L["notFound.title"]
        </h2>
        
        <p class="text-sm text-slate-500 dark:text-zinc-400 leading-relaxed mb-8 max-w-xs mx-auto">
            @L["notFound.description"]
        </p>

        <a href="/"
           class="inline-flex items-center justify-center gap-2
                  px-6 py-3 rounded-xl text-sm font-semibold text-white
                  bg-slate-900 dark:bg-white dark:text-slate-900
                  hover:bg-slate-800 dark:hover:bg-zinc-200
                  active:scale-95
                  shadow-lg shadow-slate-900/20 dark:shadow-white/10
                  transition-all duration-200">
            <HomeIcon class="w-4 h-4" />
            @L["notFound.goHome"]
        </a>
    </div>
</div>