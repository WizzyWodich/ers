@page "/"
@attribute [Authorize]

<PageTitle>@L["layout.brandSubtitle"]</PageTitle>

<div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] xl:grid-cols-[1fr_380px] gap-6 lg:gap-8">

    <div class="min-w-0">
        
        <div class="mb-6 flex items-end justify-between gap-4">
            <div>
                <h2 class="text-2xl lg:text-3xl font-bold tracking-tight">
                    @L.DayOfWeekFull(CurrentDate.DayOfWeek)
                </h2>
                <p class="text-sm lg:text-base text-slate-500 dark:text-zinc-500 mt-1">
                    @CurrentDate.Day @L.MonthName(CurrentDate.Month) @CurrentDate.Year
                </p>
            </div>
            <div class="flex items-center gap-2">
                <button @onclick="GoToToday"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg
                               bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800
                               text-xs font-medium text-slate-700 dark:text-zinc-300
                               hover:bg-slate-50 dark:hover:bg-zinc-800 transition-colors">
                    <ArrowPathIcon class="w-3.5 h-3.5" />
                    @L["nav.today"]
                </button>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg
                             bg-blue-500/10 text-blue-600 dark:text-blue-400
                             text-xs lg:text-sm font-medium">
                    @L["table.pair"]: @PairsForDate.Count
                </span>
            </div>
        </div>

        <div class="lg:hidden mb-6">
            <CalendarBlock ShowMonth="showMonth" 
                           OnToggle="ToggleCalendar" 
                           OnDayClick="SelectDate" 
                           SelectedDate="CurrentDate" />
        </div>

        <div class="space-y-2 lg:space-y-2.5">
            @if (PairsForDate.Count == 0)
            {
                <div class="rounded-2xl border border-dashed border-slate-300 dark:border-zinc-800
                            bg-white/50 dark:bg-zinc-900/20 p-12 text-center">
                    <div class="w-12 h-12 mx-auto rounded-xl bg-slate-100 dark:bg-zinc-800
                                flex items-center justify-center mb-3">
                        <SunIcon class="w-6 h-6 text-slate-400 dark:text-zinc-600" />
                    </div>
                    <p class="text-sm text-slate-500 dark:text-zinc-500">
                        @L["group.pairs"]: 0 · Выходной
                    </p>
                </div>
            }
            else
            {
                @for (int i = 0; i < PairsForDate.Count; i++)
                {
                    var pair = PairsForDate[i];
                    <PairCard Number="@(i + 1)"
                              Start="@pair.Start"
                              End="@pair.End"
                              Subject="@pair.Subject"
                              Teacher="@pair.Teacher"
                              OldTeacher="@pair.OldTeacher"
                              Room="@pair.Room"
                              Color="@pair.Color"
                              Status="@pair.Status" />

                    @if (i < PairsForDate.Count - 1)
                    {
                        <BreakDivider Duration="@pair.BreakAfterMinutes" 
                                      Type="@(pair.BreakAfterMinutes >= 30 ? "Big" : "Small")" />
                    }
                }
            }
        </div>
    </div>

    <aside class="hidden lg:block space-y-6">
        
        <div>
            <h3 class="text-[10px] font-semibold text-slate-500 dark:text-zinc-500 uppercase tracking-wider mb-2 px-1">
                @L["calendar.week"]
            </h3>
            <CalendarBlock ShowMonth="showMonth" 
                           OnToggle="ToggleCalendar" 
                           OnDayClick="SelectDate" 
                           SelectedDate="CurrentDate" />
        </div>

        <div class="rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 p-4">
            <div class="flex items-center gap-2 mb-3">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                <h3 class="text-[10px] font-semibold text-slate-500 dark:text-zinc-400 uppercase tracking-wider">
                    @L["group.today"] / Сейчас
                </h3>
            </div>
            <p class="text-sm font-semibold text-slate-900 dark:text-zinc-100">Математика</p>
            <p class="text-xs text-slate-500 dark:text-zinc-400 mt-0.5">Сидоров А.В. · 302</p>

            <div class="mt-4 space-y-1.5">
                <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-zinc-400">
                    <span>До конца пары</span>
                    <span class="font-mono font-medium text-slate-900 dark:text-zinc-100">32 мин</span>
                </div>
                <div class="h-1.5 rounded-full bg-slate-100 dark:bg-zinc-800 overflow-hidden">
                    <div class="h-full rounded-full bg-gradient-to-r from-emerald-400 to-emerald-500" style="width: 36%"></div>
                </div>
            </div>
        </div>

    </aside>
</div>