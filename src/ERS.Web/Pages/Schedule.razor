@page "/"

<PageTitle>Расписание</PageTitle>

<div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-4 lg:gap-6">

    <div class="min-w-0">
        <div class="mb-4 sm:mb-5 flex items-end justify-between gap-3">
            <div class="min-w-0">
                <h1 class="text-xl sm:text-2xl font-semibold tracking-tight truncate">Расписание на вторник</h1>
                <p class="text-sm sm:text-sm text-slate-500 dark:text-zinc-400 mt-0.5 sm:mt-1 truncate">
                    14 октября 2025 · Группа К-21
                </p>
            </div>
            <div class="text-right shrink-0">
                <span class="text-xs sm:text-[10px] font-medium text-slate-400 dark:text-zinc-500 uppercase tracking-wider">Пар</span>
                <p class="text-2xl sm:text-2xl font-bold tabular-nums leading-none">4</p>
            </div>
        </div>

        <div class="lg:hidden mb-4">
            <CalendarBlock ShowMonth="showMonth" OnToggle="ToggleView" />
        </div>

        <div class="border border-slate-200 dark:border-zinc-800 rounded-lg sm:rounded-xl overflow-hidden bg-white dark:bg-zinc-900/40">

            <div class="grid grid-cols-[80px_1fr] sm:grid-cols-[110px_1fr] bg-slate-50/80 dark:bg-zinc-900/60 border-b border-slate-200 dark:border-zinc-800">
                <div class="px-3 sm:px-4 py-2.5 sm:py-2.5 text-xs sm:text-[10px] font-semibold text-slate-500 dark:text-zinc-500 uppercase tracking-wider">
                    Время
                </div>
                <div class="px-3 sm:px-4 py-2.5 sm:py-2.5 text-xs sm:text-[10px] font-semibold text-slate-500 dark:text-zinc-500 uppercase tracking-wider border-l border-slate-200 dark:border-zinc-800">
                    Дисциплина
                </div>
            </div>

            <div class="divide-y divide-slate-100 dark:divide-zinc-800/60">

                @* Пара 1 *@
                <div class="grid grid-cols-[80px_1fr] sm:grid-cols-[110px_1fr] hover:bg-slate-50/60 dark:hover:bg-zinc-800/20 transition-colors">
                    <div class="px-3 sm:px-4 py-3.5 sm:py-4 flex flex-col justify-center">
                        <span class="text-base sm:text-sm font-mono font-semibold tabular-nums">08:00</span>
                        <span class="text-sm sm:text-xs font-mono tabular-nums text-slate-400 dark:text-zinc-500">09:20</span>
                    </div>
                    <div class="px-3 sm:px-4 py-3.5 sm:py-4 border-l border-slate-100 dark:border-zinc-800/60 min-w-0">
                        <p class="font-medium text-base sm:text-[15px] leading-tight">Программирование</p>
                        <p class="text-sm sm:text-sm text-slate-500 dark:text-zinc-400 mt-1 truncate">Петров И.С. · 301</p>
                    </div>
                </div>

                @* Малая перемена *@
                <div class="grid grid-cols-[80px_1fr] sm:grid-cols-[110px_1fr] bg-blue-50/40 dark:bg-blue-950/10">
                    <div class="px-3 sm:px-4 py-2 sm:py-1.5 flex items-center justify-center border-r border-blue-100/50 dark:border-blue-900/30">
                        <span class="text-xs sm:text-[10px] font-mono tabular-nums text-blue-600/80 dark:text-blue-400/70">09:20–09:30</span>
                    </div>
                    <div class="px-3 sm:px-4 py-2 sm:py-1.5 flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-blue-400 dark:bg-blue-500 shrink-0"></span>
                        <span class="text-xs sm:text-[10px] font-medium text-blue-600/90 dark:text-blue-400/80 uppercase tracking-wider">Перемена · 10 мин</span>
                    </div>
                </div>

                @* Пара 2 — замена препода *@
                <div class="grid grid-cols-[80px_1fr] sm:grid-cols-[110px_1fr] hover:bg-slate-50/60 dark:hover:bg-zinc-800/20 transition-colors">
                    <div class="px-3 sm:px-4 py-3.5 sm:py-4 flex flex-col justify-center">
                        <span class="text-base sm:text-sm font-mono font-semibold tabular-nums">09:30</span>
                        <span class="text-sm sm:text-xs font-mono tabular-nums text-slate-400 dark:text-zinc-500">10:50</span>
                    </div>
                    <div class="px-3 sm:px-4 py-3.5 sm:py-4 border-l border-slate-100 dark:border-zinc-800/60 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <p class="font-medium text-base sm:text-[15px] leading-tight">Математика</p>
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-amber-50 dark:bg-amber-950/30 border border-amber-200/60 dark:border-amber-900/40 text-amber-700 dark:text-amber-400 text-xs sm:text-[10px] font-medium">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3 sm:w-2.5 sm:h-2.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                                </svg>
                                Замена
                            </span>
                        </div>
                        <div class="mt-2 flex items-center gap-2 text-sm sm:text-sm flex-wrap">
                            <span class="text-slate-400 dark:text-zinc-500 line-through decoration-slate-300 dark:decoration-zinc-700">Петров И.С.</span>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 text-amber-500 dark:text-amber-400 shrink-0">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                            </svg>
                            <span class="font-semibold text-amber-700 dark:text-amber-400">Сидоров А.В.</span>
                            <span class="text-slate-400 dark:text-zinc-500">·</span>
                            <span class="text-slate-500 dark:text-zinc-400">302</span>
                        </div>
                        <p class="text-sm sm:text-xs text-slate-400 dark:text-zinc-500 mt-1.5 italic">Преподаватель на больничном</p>
                    </div>
                </div>

                @* Большая перемена *@
                <div class="grid grid-cols-[80px_1fr] sm:grid-cols-[110px_1fr] bg-violet-50/50 dark:bg-violet-950/10">
                    <div class="px-3 sm:px-4 py-2 sm:py-2 flex items-center justify-center border-r border-violet-100/60 dark:border-violet-900/30">
                        <span class="text-xs sm:text-[10px] font-mono tabular-nums text-violet-600/90 dark:text-violet-400/80">10:50–11:40</span>
                    </div>
                    <div class="px-3 sm:px-4 py-2 sm:py-2 flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-violet-400 dark:bg-violet-500 shrink-0"></span>
                        <span class="text-xs sm:text-[10px] font-semibold text-violet-700 dark:text-violet-400 uppercase tracking-wider">Большая перемена · 50 мин</span>
                    </div>
                </div>

                @* Пара 3 — замена предмета *@
                <div class="grid grid-cols-[80px_1fr] sm:grid-cols-[110px_1fr] hover:bg-slate-50/60 dark:hover:bg-zinc-800/20 transition-colors">
                    <div class="px-3 sm:px-4 py-3.5 sm:py-4 flex flex-col justify-center">
                        <span class="text-base sm:text-sm font-mono font-semibold tabular-nums">11:40</span>
                        <span class="text-sm sm:text-xs font-mono tabular-nums text-slate-400 dark:text-zinc-500">13:00</span>
                    </div>
                    <div class="px-3 sm:px-4 py-3.5 sm:py-4 border-l border-slate-100 dark:border-zinc-800/60 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <p class="font-medium text-base sm:text-[15px] leading-tight">ОБЖ</p>
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-amber-50 dark:bg-amber-950/30 border border-amber-200/60 dark:border-amber-900/40 text-amber-700 dark:text-amber-400 text-xs sm:text-[10px] font-medium">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3 sm:w-2.5 sm:h-2.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                                </svg>
                                Замена
                            </span>
                        </div>
                        <div class="mt-2 space-y-1.5">
                            <div class="flex items-center gap-2 text-sm sm:text-sm flex-wrap">
                                <span class="text-slate-400 dark:text-zinc-500 line-through decoration-slate-300 dark:decoration-zinc-700">Физкультура</span>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 text-amber-500 dark:text-amber-400 shrink-0">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                                </svg>
                                <span class="font-semibold text-amber-700 dark:text-amber-400">ОБЖ</span>
                            </div>
                            <div class="flex items-center gap-2 text-sm sm:text-sm flex-wrap">
                                <span class="text-slate-400 dark:text-zinc-500 line-through decoration-slate-300 dark:decoration-zinc-700">Иванов П.П.</span>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 text-amber-500 dark:text-amber-400 shrink-0">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                                </svg>
                                <span class="font-semibold text-amber-700 dark:text-amber-400">Смирнов Д.А.</span>
                                <span class="text-slate-400 dark:text-zinc-500">·</span>
                                <span class="text-slate-500 dark:text-zinc-400">305</span>
                            </div>
                        </div>
                        <p class="text-sm sm:text-xs text-slate-400 dark:text-zinc-500 mt-1.5 italic">Изменение по приказу деканата</p>
                    </div>
                </div>

                @* Малая перемена *@
                <div class="grid grid-cols-[80px_1fr] sm:grid-cols-[110px_1fr] bg-blue-50/40 dark:bg-blue-950/10">
                    <div class="px-3 sm:px-4 py-2 sm:py-1.5 flex items-center justify-center border-r border-blue-100/50 dark:border-blue-900/30">
                        <span class="text-xs sm:text-[10px] font-mono tabular-nums text-blue-600/80 dark:text-blue-400/70">13:00–13:10</span>
                    </div>
                    <div class="px-3 sm:px-4 py-2 sm:py-1.5 flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-blue-400 dark:bg-blue-500 shrink-0"></span>
                        <span class="text-xs sm:text-[10px] font-medium text-blue-600/90 dark:text-blue-400/80 uppercase tracking-wider">Перемена · 10 мин</span>
                    </div>
                </div>

                @* Пара 4 — отменена *@
                <div class="grid grid-cols-[80px_1fr] sm:grid-cols-[110px_1fr] bg-slate-50/50 dark:bg-zinc-900/20">
                    <div class="px-3 sm:px-4 py-3.5 sm:py-4 flex flex-col justify-center">
                        <span class="text-base sm:text-sm font-mono font-semibold tabular-nums text-slate-400 dark:text-zinc-600">13:10</span>
                        <span class="text-sm sm:text-xs font-mono tabular-nums text-slate-300 dark:text-zinc-700">14:30</span>
                    </div>
                    <div class="px-3 sm:px-4 py-3.5 sm:py-4 border-l border-slate-100 dark:border-zinc-800/60 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <p class="font-medium text-base sm:text-[15px] leading-tight text-slate-400 dark:text-zinc-500 line-through decoration-slate-300 dark:decoration-zinc-600">История</p>
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-red-50 dark:bg-red-950/30 border border-red-200/60 dark:border-red-900/40 text-red-600 dark:text-red-400 text-xs sm:text-[10px] font-medium">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3 sm:w-2.5 sm:h-2.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                                </svg>
                                Отменено
                            </span>
                        </div>
                        <p class="text-sm sm:text-sm text-slate-400 dark:text-zinc-600 mt-1 truncate">Кузнецова М.И. · 305</p>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <aside class="hidden lg:block space-y-4">
        <div>
            <h3 class="text-[10px] font-semibold text-slate-400 dark:text-zinc-500 uppercase tracking-wider mb-2 px-1">
                Неделя
            </h3>
            <CalendarBlock ShowMonth="showMonth" OnToggle="ToggleView" />
        </div>

        <div class="rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 p-4">
            <div class="flex items-center gap-2 mb-3">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                <h3 class="text-[10px] font-semibold text-slate-500 dark:text-zinc-400 uppercase tracking-wider">
                    Сейчас идёт
                </h3>
            </div>
            <p class="text-sm font-semibold text-slate-900 dark:text-zinc-100">Математика</p>
            <p class="text-xs text-slate-500 dark:text-zinc-400 mt-0.5">Сидоров А.В. · 302</p>
            <div class="mt-3 space-y-1.5">
                <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-zinc-400">
                    <span>До конца пары</span>
                    <span class="font-mono font-medium text-slate-900 dark:text-zinc-100">32 мин</span>
                </div>
                <div class="h-1.5 rounded-full bg-slate-100 dark:bg-zinc-800 overflow-hidden">
                    <div class="h-full rounded-full bg-gradient-to-r from-emerald-400 to-emerald-500" style="width: 36%"></div>
                </div>
            </div>
        </div>

        <div class="rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 p-4">
            <h3 class="text-[10px] font-semibold text-slate-500 dark:text-zinc-400 uppercase tracking-wider mb-3">
                Статистика
            </h3>
            <div class="space-y-2.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs text-slate-500 dark:text-zinc-400">Пар в день</span>
                    <span class="text-sm font-semibold tabular-nums">4</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-slate-500 dark:text-zinc-400">Начало</span>
                    <span class="text-sm font-semibold tabular-nums font-mono">08:00</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-slate-500 dark:text-zinc-400">Конец</span>
                    <span class="text-sm font-semibold tabular-nums font-mono">14:30</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-slate-500 dark:text-zinc-400">Замен</span>
                    <span class="text-sm font-semibold tabular-nums text-amber-600 dark:text-amber-400">2</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-slate-500 dark:text-zinc-400">Отменено</span>
                    <span class="text-sm font-semibold tabular-nums text-red-500">1</span>
                </div>
            </div>
        </div>
    </aside>
</div>

@code {
    private bool showMonth;

    private void ToggleView(bool month) => showMonth = month;
}