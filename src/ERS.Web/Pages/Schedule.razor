@page "/"
@inject Localizer L

<PageTitle>@L["layout.brandSubtitle"]</PageTitle>

<div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] xl:grid-cols-[1fr_380px] gap-6 lg:gap-8">

    <div class="min-w-0">
        
        <div class="mb-6 flex items-end justify-between gap-4">
            <div>
                <h2 class="text-2xl lg:text-3xl font-bold tracking-tight">@L["day.tuesday"]</h2>
                <p class="text-sm lg:text-base text-slate-500 dark:text-zinc-500 mt-1">14 @L["month.10"] 2025</p>
            </div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full
                         bg-blue-500/10 text-blue-600 dark:text-blue-400
                         text-xs lg:text-sm font-medium">
                @L["table.pair"]: 3
            </span>
        </div>

        <div class="lg:hidden mb-6">
            <CalendarBlock ShowMonth="false" OnToggle="(m) => {}" OnDayClick="(d) => {}" SelectedDate="DateOnly.FromDateTime(DateTime.Today)" />
        </div>

        <div class="space-y-2 lg:space-y-2.5">
            
            <PairCard Number="1"
                      Start="08:30"
                      End="09:50"
                      Subject="Програмування"
                      Teacher="Петров І.С."
                      Room="301"
                      Color="blue"
                      Status="Normal" />

            <BreakDivider Duration="20" Type="Small" />

            <PairCard Number="2"
                      Start="10:10"
                      End="11:30"
                      Subject="Математика"
                      Teacher="Сидоров О.В."
                      OldTeacher="Петров І.С."
                      Room="302"
                      Color="amber"
                      Status="Substituted" />

            <BreakDivider Duration="40" Type="Big" />

            <PairCard Number="3"
                      Start="12:10"
                      End="13:30"
                      Subject="Історія"
                      Teacher="Кузнєцова М.І."
                      Room="305"
                      Color="slate"
                      Status="Cancelled" />
        </div>
    </div>

    <aside class="hidden lg:block space-y-6">
        
        <div>
            <h3 class="text-[10px] font-semibold text-slate-500 dark:text-zinc-500 uppercase tracking-wider mb-2 px-1">
                @L["calendar.week"]
            </h3>
            <CalendarBlock ShowMonth="false" OnToggle="(m) => {}" OnDayClick="(d) => {}" SelectedDate="DateOnly.FromDateTime(DateTime.Today)" />
        </div>

        <div class="rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 p-4">
            <div class="flex items-center gap-2 mb-3">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                <h3 class="text-[10px] font-semibold text-slate-500 dark:text-zinc-400 uppercase tracking-wider">
                    @L["group.today"] / Сейчас
                </h3>
            </div>
            <p class="text-sm font-semibold text-slate-900 dark:text-zinc-100">Математика</p>
            <p class="text-xs text-slate-500 dark:text-zinc-400 mt-0.5">Сидоров А.В. · 302</p>

            <div class="mt-4 space-y-1.5">
                <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-zinc-400">
                    <span>До конца пары</span>
                    <span class="font-mono font-medium text-slate-900 dark:text-zinc-100">32 мин</span>
                </div>
                <div class="h-1.5 rounded-full bg-slate-100 dark:bg-zinc-800 overflow-hidden">
                    <div class="h-full rounded-full bg-gradient-to-r from-emerald-400 to-emerald-500" style="width: 36%"></div>
                </div>
            </div>
        </div>

    </aside>
</div>