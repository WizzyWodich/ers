@layout EmptyLayout
@page "/register"

<div class="min-h-screen flex items-center justify-center px-4 bg-slate-50 dark:bg-zinc-950">
    <div class="w-full max-w-md bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-2xl shadow-xl p-8 text-center">
        
        <div class="w-16 h-16 mx-auto rounded-2xl bg-amber-500/10 flex items-center justify-center mb-6">
            <LockClosedIcon class="w-8 h-8 text-amber-500" />
        </div>

        <h1 class="text-xl font-semibold text-slate-900 dark:text-zinc-100 mb-3">
            Регистрация закрыта
        </h1>
        
        <p class="text-sm text-slate-500 dark:text-zinc-400 mb-8">
            Аккаунты создаются администратором колледжа. Если у вас нет доступа, пожалуйста, обратитесь в деканат или к вашему куратору для получения корпоративной почты и пароля.
        </p>

        <a href="/login" class="inline-flex items-center justify-center w-full px-4 py-2.5 rounded-lg text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 transition-colors">
            Вернуться на страницу входа
        </a>
    </div>
</div>