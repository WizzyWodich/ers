@layout EmptyLayout
@page "/login"
@inject NavigationManager Nav
@inject IAuthService Auth
@inject Localizer L

<PageTitle>@L["login.title"]</PageTitle>

<div class="relative min-h-screen flex items-center justify-center overflow-hidden
            bg-slate-50 dark:bg-zinc-950 transition-colors duration-300">

    <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-[10%] -left-[10%] w-[40vw] h-[40vw] max-w-[600px] max-h-[600px]
                    rounded-full bg-blue-400/20 dark:bg-blue-600/10 filter blur-[80px] animate-blob"></div>
        <div class="absolute top-[20%] -right-[10%] w-[35vw] h-[35vw] max-w-[500px] max-h-[500px]
                    rounded-full bg-indigo-400/20 dark:bg-indigo-600/10 filter blur-[80px] animate-blob animation-delay-2000"></div>
        <div class="absolute -bottom-[10%] left-[20%] w-[30vw] h-[30vw] max-w-[400px] max-h-[400px]
                    rounded-full bg-violet-400/20 dark:bg-violet-600/10 filter blur-[80px] animate-blob animation-delay-4000"></div>
    </div>

    <div class="absolute top-4 right-4 z-20 flex items-center gap-2">
        <LanguageSwitcher />
        <ThemeToggle />
    </div>

    <div class="relative z-10 w-full max-w-md px-4 animate-slide-up">
        
        <div class="backdrop-blur-2xl bg-white/70 dark:bg-zinc-900/60
                    border border-white/40 dark:border-zinc-800/50
                    rounded-3xl shadow-2xl shadow-blue-500/10 dark:shadow-black/40
                    p-8 sm:p-10 transition-colors duration-300">

            <div class="text-center mb-8">
                <div class="w-16 h-16 mx-auto rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600
                            flex items-center justify-center mb-4 shadow-lg shadow-blue-500/30">
                    <CalendarDaysIcon class="w-8 h-8 text-white" />
                </div>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-zinc-100">
                    @L["login.title"]
                </h1>
                <p class="text-sm text-slate-500 dark:text-zinc-400 mt-1">
                    @L["login.subtitle"]
                </p>
            </div>

            @* Ошибка с анимацией *@
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="mb-5 p-3 rounded-xl bg-red-500/10 border border-red-500/20
                            text-sm text-red-600 dark:text-red-400 flex items-center gap-2 animate-slide-up">
                    <ExclamationCircleIcon class="w-4 h-4 shrink-0" />
                    @error
                </div>
            }

            <div class="space-y-5">
                @* Email *@
                <div>
                    <label class="block text-xs font-semibold text-slate-500 dark:text-zinc-400 mb-1.5 ml-1">
                        @L["login.email"]
                    </label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                            <EnvelopeIcon class="w-4 h-4 text-slate-400 group-focus-within:text-blue-500 transition-colors" />
                        </div>
                        <input type="email" @bind="email" placeholder="student@college.ua"
                               class="w-full pl-10 pr-4 py-3 rounded-xl text-sm
                                      bg-white/50 dark:bg-zinc-950/50
                                      text-slate-900 dark:text-zinc-100
                                      border border-slate-200/70 dark:border-zinc-800/70
                                      hover:border-slate-300 dark:hover:border-zinc-700
                                      placeholder-slate-400 dark:placeholder-zinc-600
                                      focus:bg-white dark:focus:bg-zinc-900
                                      focus:outline-none focus:ring-4 focus:ring-blue-500/15 focus:border-blue-500/50
                                      transition-all duration-300" />
                    </div>
                </div>

                @* Пароль *@
                <div>
                    <label class="block text-xs font-semibold text-slate-500 dark:text-zinc-400 mb-1.5 ml-1">
                        @L["login.password"]
                    </label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                            <LockClosedIcon class="w-4 h-4 text-slate-400 group-focus-within:text-blue-500 transition-colors" />
                        </div>
                        <input type="@(showPassword ? "text" : "password")" @bind="password" placeholder="••••••••"
                               class="w-full pl-10 pr-10 py-3 rounded-xl text-sm
                                      bg-white/50 dark:bg-zinc-950/50
                                      text-slate-900 dark:text-zinc-100
                                      border border-slate-200/70 dark:border-zinc-800/70
                                      hover:border-slate-300 dark:hover:border-zinc-700
                                      placeholder-slate-400 dark:placeholder-zinc-600
                                      focus:bg-white dark:focus:bg-zinc-900
                                      focus:outline-none focus:ring-4 focus:ring-blue-500/15 focus:border-blue-500/50
                                      transition-all duration-300" />
                        <button type="button" @onclick="() => showPassword = !showPassword"
                                class="absolute inset-y-0 right-0 pr-3.5 flex items-center
                                       text-slate-400 hover:text-slate-600 dark:hover:text-zinc-300 transition-colors">
                            @if (showPassword)
                            {
                                <EyeSlashIcon class="w-4 h-4" />
                            }
                            else
                            {
                                <EyeIcon class="w-4 h-4" />
                            }
                        </button>
                    </div>
                </div>

                @* Кнопка входа *@
                <button @onclick="HandleLogin" disabled="@isLoading"
                        class="w-full relative flex items-center justify-center gap-2
                               py-3 mt-2 rounded-xl text-sm font-semibold text-white
                               bg-gradient-to-r from-blue-500 to-indigo-600
                               hover:from-blue-600 hover:to-indigo-700
                               active:scale-[0.98]
                               shadow-lg shadow-blue-500/30
                               disabled:opacity-70 disabled:cursor-not-allowed
                               transition-all duration-200">
                    @if (isLoading)
                    {
                        <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>@L["login.loading"]</span>
                    }
                    else
                    {
                        <span>@L["login.submit"]</span>
                        <ArrowRightIcon class="w-4 h-4" />
                    }
                </button>
            </div>

            @* Ссылка на регистрацию *@
            <div class="mt-8 text-center">
                <p class="text-xs text-slate-500 dark:text-zinc-400">
                    @L["login.noAccount"]
                    <a href="/register" class="font-semibold text-blue-600 dark:text-blue-400 hover:underline ml-1 transition-colors">
                        @L["login.register"]
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string? error;
    private bool isLoading;
    private bool showPassword;

    private async Task HandleLogin()
    {
        error = null;
        isLoading = true;

        try
        {
            await Task.Delay(800); 
            
            var success = await Auth.LoginAsync(email, password);
            if (success)
            {
                Nav.NavigateTo("/");
            }
            else
            {
                error = L["login.invalid"];
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}