@layout EmptyLayout
@page "/login"

<PageTitle>@L["login.title"]</PageTitle>

<div class="relative min-h-screen flex items-center justify-center overflow-hidden
            bg-slate-50 dark:bg-zinc-950 transition-colors duration-300">

    @* Тот самый янтарный фон, который тебе понравился *@
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-[20%] -left-[10%] w-[50vw] h-[50vw] max-w-[800px] max-h-[800px]
                    rounded-full bg-amber-200/50 dark:bg-amber-900/10 filter blur-[100px] animate-blob"></div>
    </div>

    <div class="absolute top-4 right-4 z-20 flex items-center gap-2">
        <LanguageSwitcher />
        <ThemeToggle />
    </div>

    <div class="relative z-10 w-full max-w-[400px] px-4 animate-slide-up">
        
        <div class="bg-white/85 dark:bg-zinc-900/85 backdrop-blur-sm
                    border border-slate-200/80 dark:border-zinc-800
                    rounded-2xl shadow-2xl shadow-amber-900/5 dark:shadow-black/40
                    p-8 sm:p-10 transition-colors duration-300">

            @* Логотип (Теперь он точно будет синим) *@
            <div class="flex justify-center mb-6">
                <div class="w-12 h-12 rounded-xl bg-blue-600
                            flex items-center justify-center shadow-lg shadow-blue-500/30">
                    <CalendarDaysIcon class="w-6 h-6 text-white" />
                </div>
            </div>

            <div class="text-center mb-8">
                <h1 class="text-[22px] font-semibold tracking-tight text-slate-900 dark:text-zinc-100 focus:outline-none">
                    @L["login.title"]
                </h1>
                <p class="text-sm text-slate-500 dark:text-zinc-400 mt-1.5">
                    @L["login.subtitle"]
                </p>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="mb-6 p-3 rounded-lg bg-red-50 dark:bg-red-900/20 text-sm text-red-600 dark:text-red-400 flex items-start gap-2">
                    <ExclamationCircleIcon class="w-4 h-4 shrink-0 mt-0.5" />
                    <span>@error</span>
                </div>
            }

            <div class="space-y-4">
                <div>
                    <label class="block text-[13px] font-medium text-slate-700 dark:text-zinc-300 mb-1.5">
                        @L["login.email"]
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <EnvelopeIcon class="w-4 h-4 text-slate-400" />
                        </div>
                        <input type="email" @bind="email" placeholder="student@college.ua"
                               class="w-full pl-9 pr-3 py-2.5 rounded-lg text-sm
                                      bg-slate-50 dark:bg-zinc-950
                                      text-slate-900 dark:text-zinc-100
                                      border border-slate-300 dark:border-zinc-800
                                      placeholder-slate-400 dark:placeholder-zinc-500
                                      focus:bg-white dark:focus:bg-zinc-900
                                      focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500
                                      transition-all duration-200" />
                    </div>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-[13px] font-medium text-slate-700 dark:text-zinc-300">
                            @L["login.password"]
                        </label>
                        <a href="#" class="text-[12px] font-medium text-blue-600 hover:text-blue-500">
                            @L["login.forgotPassword"]
                        </a>
                    </div>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <LockClosedIcon class="w-4 h-4 text-slate-400" />
                        </div>
                        <input type="@(showPassword ? "text" : "password")" @bind="password" placeholder="••••••••"
                               class="w-full pl-9 pr-10 py-2.5 rounded-lg text-sm
                                      bg-slate-50 dark:bg-zinc-950
                                      text-slate-900 dark:text-zinc-100
                                      border border-slate-300 dark:border-zinc-800
                                      placeholder-slate-400 dark:placeholder-zinc-500
                                      focus:bg-white dark:focus:bg-zinc-900
                                      focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500
                                      transition-all duration-200" />
                        <button type="button" @onclick="() => showPassword = !showPassword"
                                class="absolute inset-y-0 right-0 pr-3 flex items-center
                                       text-slate-400 hover:text-slate-600 dark:hover:text-zinc-300">
                            @if (showPassword)
                            {
                                <EyeSlashIcon class="w-4 h-4" />
                            }
                            else
                            {
                                <EyeIcon class="w-4 h-4" />
                            }
                        </button>
                    </div>
                </div>

                @* Кнопка (Вернулась на место) *@
                <button @onclick="HandleLogin" disabled="@isLoading"
                        class="w-full flex items-center justify-center gap-2
                               py-2.5 mt-2 rounded-lg text-sm font-medium text-white
                               bg-blue-600 hover:bg-blue-700
                               active:scale-[0.98]
                               shadow-md shadow-blue-500/20
                               disabled:opacity-70 disabled:cursor-not-allowed
                               transition-all duration-200">
                    @if (isLoading)
                    {
                        <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>@L["login.loading"]</span>
                    }
                    else
                    {
                        <span>@L["login.submit"]</span>
                    }
                </button>
            </div>

            <div class="mt-8 text-center pt-6 border-t border-slate-100 dark:border-zinc-800">
                <p class="text-[13px] text-slate-500 dark:text-zinc-400">
                    Нет аккаунта? Обратитесь к администратору для получения доступов.
                </p>
            </div>
        </div>
    </div>
</div>